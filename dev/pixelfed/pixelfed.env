# DEV-ONLY configuration for the local Pixelfed test instance (dev/pixelfed/docker-compose.yml).
# Every secret in this file is a throwaway value for a loopback-only instance; it is committed on purpose.
# NEVER reuse these values for anything reachable from a network.
# A public instance (dev/hetzner/provision.sh --pixelfed-domain) gets a fresh APP_KEY and seed passwords in
# the gitignored pixelfed.local.env next to this file, which overrides these values.

# --- Application ---
APP_NAME="Construct Dev Pixelfed"
APP_ENV="local"
APP_KEY="base64:XgoLfd7+kJOKPi61MthZ7qAi9SudZftsNbMc4X9WIfY="
APP_DEBUG="false"
APP_LOCALE="en"
# Web routes (login, /oauth/authorize) only match Host "localhost" (Laravel domain routes ignore the port).
# The /api/* routes answer on any Host (127.0.0.1:8090, 10.0.2.2:8090, ...).
APP_URL="http://localhost:8090"
APP_DOMAIN="localhost"
ADMIN_DOMAIN="localhost"
SESSION_DOMAIN=null
# Plain HTTP on loopback: no https URL forcing, no Secure-only session cookie.
FORCE_HTTPS_URLS="false"
SESSION_SECURE_COOKIE="false"
TRUSTED_PROXY="off"
TRUST_PROXIES="*"

# --- Instance ---
OPEN_REGISTRATION="false"
ENFORCE_EMAIL_VERIFICATION="false"
PF_MAX_USERS="100"
OAUTH_ENABLED="true"
OAUTH_PAT_ENABLED="true"
ENABLE_CONFIG_CACHE="false"
INSTANCE_DISCOVER_PUBLIC="true"
PF_OPTIMIZE_IMAGES="true"
IMAGE_DRIVER="gd"
MAX_ALBUM_LENGTH="4"
MEDIA_TYPES="image/jpeg,image/jpg,image/png,image/gif"

# --- Federation (ActivityPub) OFF: this instance must never talk to the fediverse ---
ACTIVITY_PUB="false"
AP_REMOTE_FOLLOW="false"
AP_INBOX="false"
AP_OUTBOX="false"
AP_SHAREDINBOX="false"
PF_NETWORK_TIMELINE="false"

# --- Database (MariaDB, internal network only) ---
DB_CONNECTION="mysql"
DB_HOST="db"
DB_PORT="3306"
DB_DATABASE="pixelfed"
DB_USERNAME="pixelfed"
DB_PASSWORD="dev-only-pixelfed-db-pw"
MARIADB_DATABASE="pixelfed"
MARIADB_USER="pixelfed"
MARIADB_PASSWORD="dev-only-pixelfed-db-pw"
MARIADB_ROOT_PASSWORD="dev-only-root-pw"

# --- Redis (internal network only) ---
REDIS_CLIENT="phpredis"
REDIS_SCHEME="tcp"
REDIS_HOST="redis"
REDIS_PASSWORD=null
REDIS_PORT="6379"

# --- Laravel ---
SESSION_DRIVER="database"
CACHE_STORE="redis"
CACHE_DRIVER="redis"
QUEUE_DRIVER="redis"
BROADCAST_DRIVER="log"
LOG_CHANNEL="stderr"
HORIZON_PREFIX="horizon-"

# --- Mail: log only (nothing is ever sent) ---
MAIL_DRIVER="log"
MAIL_MAILER="log"
MAIL_FROM_ADDRESS="pixelfed@example.test"
MAIL_FROM_NAME="Construct Dev Pixelfed"

PF_ENABLE_CLOUD="false"
