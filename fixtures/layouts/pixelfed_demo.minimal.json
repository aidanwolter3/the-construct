{
  "type": "core://Workspace",
  "id": "home_stream",
  "title": "Home",
  "slots": [
    {
      "slot_id": "feed",
      "provider_uri": "pixelfed://home_timeline",
      "content": {
        "type": "pixelfed://FeedList",
        "query_key": "timeline:home",
        "item_template": {
          "type": "pixelfed://PostCard",
          "post_ref": "$item.uri",
          "author_slot": {
            "type": "pixelfed://AuthorHeader",
            "user_ref": "$item.author_uri"
          },
          "media_slot": {
            "type": "pixelfed://MediaCarousel",
            "media_refs": "$item.media_uris",
            "aspect_ratio": 1.0
          },
          "action_slot": {
            "type": "core://Container",
            "orientation": "Vertical",
            "padding_dp": 0,
            "children": []
          },
          "caption_slot": {
            "type": "core://Text",
            "value_expr": "entity.caption",
            "style": "Body"
          }
        }
      }
    }
  ]
}
