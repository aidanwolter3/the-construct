  },
  "collections://todos/3": {
   "id": "3",
   "title": "Buy milk",
   "done": false,
   "deleted": false,
   "due": "2026-11-05"
  },
  "collections://todos/4": {
   "id": "4",
   "title": "Book flights",
   "done": false,
   "deleted": false,
   "due": "2026-11-07"
  },
  "collections://todos/5": {
   "id": "5",
   "title": "Pay rent",
   "done": true,
