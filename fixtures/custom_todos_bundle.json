   "done": false,
   "deleted": false,
   "due": null
  }
 },
 "queries": {
  "collection:todos": [
   "collections://todos/1",
   "collections://todos/2",
   "collections://todos/3",
   "collections://todos/4",
   "collections://todos/5",
   "collections://todos/6"
  ]
 }
}