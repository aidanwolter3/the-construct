  "version": "1.0.0",
  "workspace": {
    "id": "pixelfed_home",
    "screens": [
      {
        "content": {
          "empty_text": "No comments yet. Be the first!",
          "indent": {
            "field": "depth",
            "max": 4,
            "step_dp": 24
          },
          "item_template": {
            "children": [
              {
                "children": [
                  {
                    "content_description": "$item.author_name",
                    "shape": "Circle",
                    "size_dp": 28,
                    "type": "core://Image",
                    "url": "$item.avatar_url"
                  },
                  {
                    "style": "Body",
                    "type": "core://Text",
                    "value_expr": "$item.author_name"
                  }
                ],
                "orientation": "Horizontal",
                "padding_dp": 0,
                "type": "core://Container"
              },
              {
                "style": "Body",
                "type": "core://Text",
                "value_expr": "$item.text"
              },
              {
                "style": "Caption",
                "type": "core://Text",
                "value_expr": "$item.meta"
              }
            ],
            "orientation": "Vertical",
            "padding_dp": 8,
            "type": "core://Container"
          },
          "query_key": "comments:$route.id",
          "type": "core://List"
        },
        "data": "/v1/pixelfed/screens/comments?post_id=$route.id",
        "footer": {
          "field": "comment",
          "max_length": 500,
          "on_submit": {
            "endpoint": "/v1/pixelfed/posts/comment",
            "entity": {
              "author_name": "You",
              "depth": 0,
              "meta": "Sending…",
              "text": "$form.comment"
            },
            "entity_uri": "pixelfed://comments/pending-$nonce",
            "intent": "action.mutation.create",
            "payload": {
              "client_id": "$nonce",
              "id": "$route.id",
              "text": "$form.comment"
            },
            "query_key": "comments:$route.id",
            "refresh_workspace": true
          },
          "placeholder": "Add a comment…",
          "type": "core://TextField"
        },
        "id": "comments",
        "route": "pixelfed://posts/{id}/comments",
        "title": "Comments"
      }
    ],
    "slots": [
      {
        "content": {
          "empty_text": "No posts",
          "item_template": {
            "children": [
              {
                "content": {
                  "icon": "repeat",
                  "text": "$item.reblogged_by_name boosted",
                  "type": "core://Badge"
                },
                "type": "core://Conditional",
                "value": "$item.reblogged_by_name"
              },
              {
                "children": [
                  {
                    "shape": "Circle",
                    "size_dp": 36,
                    "type": "core://Image",
                    "url": "$item.author_avatar_url"
                  },
                  {
                    "children": [
                      {
                        "style": "Label",
                        "type": "core://Text",
                        "value_expr": "$item.author_name"
                      },
                      {
                        "style": "Secondary",
                        "type": "core://Text",
                        "value_expr": "$item.author_handle"
                      }
                    ],
                    "type": "core://Column"
                  }
                ],
                "padding_h_dp": 12,
                "padding_v_dp": 10,
                "spacing_dp": 10,
                "type": "core://Row"
              },
              {
                "aspect_field": "aspect_ratio",
                "aspect_ratio": 1.0,
                "item_template": {
                  "blurhash": "$item.blurhash",
                  "content_description": "$item.alt_text",
                  "type": "core://Image",
                  "url": "$item.url"
                },
                "items": "$item.media_uris",
                "max_aspect": 1.91,
                "min_aspect": 0.8,
                "tag": "carousel:$item.uri",
                "type": "core://Carousel"
              },
              {
                "children": [
                  {
                    "active": "$item.is_liked",
                    "active_content_description": "Unlike",
                    "active_icon": "favorite",
                    "active_tint": "#ED4956",
                    "content_description": "Like",
                    "icon": "favorite_border",
                    "on_click": {
                      "also": [
                        {
                          "field": "like_count",
                          "value_expr": "entity.is_liked ? entity.like_count - 1 : entity.like_count + 1"
                        }
                      ],
                      "endpoint": "/v1/pixelfed/posts/like",
                      "entity_uri": "$item.uri",
                      "field": "is_liked",
                      "intent": "action.mutation.optimistic",
                      "payload": {
                        "id": "$item.id",
                        "liked": "$value"
                      },
                      "rollback_value": false,
                      "value_expr": "!entity.is_liked"
                    },
                    "tag": "like:$item.uri",
                    "type": "core://IconButton"
                  },
                  {
                    "style": "Label",
                    "type": "core://Text",
                    "value_expr": "$item.like_count"
                  },
                  {
                    "size_dp": 8,
                    "type": "core://Spacer"
                  },
                  {
                    "content_description": "Comment",
                    "icon": "chat_bubble",
                    "on_click": {
                      "intent": "action.navigation.open",
                      "presentation": "Modal",
                      "target_uri": "pixelfed://posts/$item.id/comments"
                    },
                    "tag": "comment:$item.uri",
                    "type": "core://IconButton"
                  },
                  {
                    "content": {
                      "style": "Label",
                      "type": "core://Text",
                      "value_expr": "$item.reply_count"
                    },
                    "type": "core://Conditional",
                    "value": "$item.reply_count"
                  },
                  {
                    "type": "core://Spacer"
                  },
                  {
                    "active": "$item.is_bookmarked",
                    "active_content_description": "Remove bookmark",
                    "active_icon": "bookmark",
                    "content_description": "Bookmark",
                    "icon": "bookmark_border",
                    "on_click": {
                      "endpoint": "/v1/pixelfed/posts/bookmark",
                      "entity_uri": "$item.uri",
                      "field": "is_bookmarked",
                      "intent": "action.mutation.optimistic",
                      "payload": {
                        "bookmarked": "$value",
                        "id": "$item.id"
                      },
                      "rollback_value": false,
                      "value_expr": "!entity.is_bookmarked"
                    },
                    "tag": "bookmark:$item.uri",
                    "type": "core://IconButton"
                  }
                ],
                "padding_h_dp": 4,
                "type": "core://Row"
              },
              {
                "content": {
                  "children": [
                    {
                      "icon": "warning",
                      "text": "$item.content_warning_label",
                      "tone": "Warning",
                      "type": "core://Chip"
                    }
                  ],
                  "padding_h_dp": 14,
                  "padding_v_dp": 4,
                  "type": "core://Column"
                },
                "type": "core://Conditional",
                "value": "$item.content_warning"
              },
              {
                "content": {
                  "children": [
                    {
                      "style": "Body",
                      "type": "core://Text",
                      "value_expr": "$item.caption"
                    }
                  ],
                  "padding_h_dp": 14,
                  "type": "core://Column"
                },
                "type": "core://Conditional",
                "value": "$item.caption"
              },
              {
                "size_dp": 12,
                "type": "core://Spacer"
              },
              {
                "type": "core://Divider"
              }
            ],
            "type": "core://Column"
          },
          "query_key": "timeline:home",
          "type": "core://List"
        },
        "provider_uri": "pixelfed://home_timeline",
        "slot_id": "feed"
      }
    ],
    "title": "Pixelfed",
    "type": "core://Workspace"
  }
}
