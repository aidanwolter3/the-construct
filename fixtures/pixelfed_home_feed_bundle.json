  "version": "1.0.0",
  "workspace": {
    "id": "pixelfed_home",
    "screens": [
      {
        "content": {
          "empty_text": "No comments yet. Be the first!",
          "indent": {
            "field": "depth",
            "max": 4,
            "step_dp": 24
          },
          "item_template": {
            "children": [
              {
                "children": [
                  {
                    "content_description": "$item.author_name",
                    "shape": "Circle",
                    "size_dp": 28,
                    "type": "core://Image",
                    "url": "$item.avatar_url"
                  },
                  {
                    "style": "Body",
                    "type": "core://Text",
                    "value_expr": "$item.author_name"
                  }
                ],
                "orientation": "Horizontal",
                "padding_dp": 0,
                "type": "core://Container"
              },
              {
                "style": "Body",
                "type": "core://Text",
                "value_expr": "$item.text"
              },
              {
                "style": "Caption",
                "type": "core://Text",
                "value_expr": "$item.meta"
              }
            ],
            "orientation": "Vertical",
            "padding_dp": 8,
            "type": "core://Container"
          },
          "query_key": "comments:$route.id",
          "type": "core://List"
        },
        "data": "/v1/pixelfed/screens/comments?post_id=$route.id",
        "footer": {
          "field": "comment",
          "max_length": 500,
          "on_submit": {
            "endpoint": "/v1/pixelfed/posts/comment",
            "entity": {
              "author_name": "You",
              "depth": 0,
              "meta": "Sending…",
              "text": "$form.comment"
            },
            "entity_uri": "pixelfed://comments/pending-$nonce",
            "intent": "action.mutation.create",
            "payload": {
              "client_id": "$nonce",
              "id": "$route.id",
              "text": "$form.comment"
            },
            "query_key": "comments:$route.id",
            "refresh_workspace": true
          },
          "placeholder": "Add a comment…",
          "type": "core://TextField"
        },
        "id": "comments",
        "route": "pixelfed://posts/{id}/comments",
        "title": "Comments"
      }
    ],
    "slots": [
      {
        "content": {
          "item_template": {
            "action_slot": {
              "bookmark_intent": {
                "endpoint": "/v1/pixelfed/posts/bookmark",
                "entity_uri": "$item.uri",
                "field": "is_bookmarked",
                "intent": "action.mutation.optimistic",
                "payload": {
                  "bookmarked": "$value",
                  "id": "$item.id"
                },
                "rollback_value": false,
                "value_expr": "!entity.is_bookmarked"
              },
              "comment_intent": {
                "intent": "action.navigation.open",
                "presentation": "Modal",
                "target_uri": "pixelfed://posts/$item.id/comments"
              },
              "like_intent": {
                "also": [
                  {
                    "field": "like_count",
                    "value_expr": "entity.is_liked ? entity.like_count - 1 : entity.like_count + 1"
                  }
                ],
                "endpoint": "/v1/pixelfed/posts/like",
                "entity_uri": "$item.uri",
                "field": "is_liked",
                "intent": "action.mutation.optimistic",
                "payload": {
                  "id": "$item.id",
                  "liked": "$value"
                },
                "rollback_value": false,
                "value_expr": "!entity.is_liked"
              },
              "type": "pixelfed://ActionBar"
            },
            "author_slot": {
              "type": "pixelfed://AuthorHeader",
              "user_ref": "$item.author_uri"
            },
            "caption_slot": {
              "style": "Body",
              "type": "core://Text",
              "value_expr": "entity.caption"
            },
            "media_slot": {
              "aspect_ratio": 1.0,
              "media_refs": "$item.media_uris",
              "type": "pixelfed://MediaCarousel"
            },
            "post_ref": "$item.uri",
            "type": "pixelfed://PostCard"
          },
          "query_key": "timeline:home",
          "type": "pixelfed://FeedList"
        },
        "provider_uri": "pixelfed://home_timeline",
        "slot_id": "feed"
      }
    ],
    "title": "Pixelfed",
    "type": "core://Workspace"
  }
}
