{
  "entities": {
    "core://counters/home": {
      "count": 0,
      "id": "home"
    }
  },
  "version": "1.0.0",
  "workspace": {
    "id": "home",
    "root": {
      "children": [
        {
          "content": {
            "children": [
              {
                "content": {
                  "content_description": "Back",
                  "icon": "arrow_back",
                  "on_click": {
                    "intent": "action.navigation.back"
                  },
                  "tag": "layout-back",
                  "type": "core://IconButton"
                },
                "type": "core://Conditional",
                "value": "${local://nav#pushed}"
              },
              {
                "children": [
                  {
                    "style": "Headline",
                    "type": "core://Text",
                    "value_expr": "Home"
                  }
                ],
                "padding_h_dp": 16,
                "padding_v_dp": 12,
                "type": "core://Column"
              }
            ],
            "type": "core://Row"
          },
          "equals": "false",
          "type": "core://Conditional",
          "value": "${local://nav#inline}"
        },
        {
          "content": {
            "children": [
              {
                "children": [
                  {
                    "style": "Title",
                    "type": "core://Text",
                    "value_expr": "The Construct Counter"
                  },
                  {
                    "style": "Headline",
                    "type": "core://Text",
                    "value_expr": "Count: ${core://counters/home#count}"
                  },
                  {
                    "children": [
                      {
                        "label": "Increment",
                        "on_click": {
                          "endpoint": "/v1/counters/home/increment",
                          "entity_uri": "core://counters/home",
                          "field": "count",
                          "intent": "action.mutation.optimistic",
                          "payload": {},
                          "rollback_value": 0,
                          "value_expr": "entity.count + 1"
                        },
                        "type": "core://Button"
                      },
                      {
                        "label": "Decrement",
                        "on_click": {
                          "endpoint": "/v1/counters/home/decrement",
                          "entity_uri": "core://counters/home",
                          "field": "count",
                          "intent": "action.mutation.optimistic",
                          "payload": {},
                          "rollback_value": 0,
                          "value_expr": "entity.count - 1"
                        },
                        "type": "core://Button"
                      },
                      {
                        "label": "Reset",
                        "on_click": {
                          "endpoint": "/v1/counters/home/reset",
                          "entity_uri": "core://counters/home",
                          "field": "count",
                          "intent": "action.mutation.optimistic",
                          "payload": {},
                          "rollback_value": 0,
                          "value_expr": "0"
                        },
                        "type": "core://Button"
                      }
                    ],
                    "orientation": "Horizontal",
                    "padding_dp": 8,
                    "type": "core://Container"
                  }
                ],
                "orientation": "Vertical",
                "padding_dp": 24,
                "type": "core://Container"
              },
              {
                "content": {
                  "size_dp": 16,
                  "type": "core://Spacer"
                },
                "equals": "false",
                "type": "core://Conditional",
                "value": "${local://nav#inline}"
              }
            ],
            "type": "core://Column"
          },
          "type": "core://Scroll"
        }
      ],
      "type": "core://Column"
    },
    "title": "Home",
    "type": "core://Page"
  }
}
