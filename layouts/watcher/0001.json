{
  "note": "Watcher: upcoming matched events, sites with their health, rules (issue #58)",
  "schema": 12,
  "layout": {
    "type": "core://Workspace",
    "id": "watcher",
    "title": "Watcher",
    "slots": [
      {
        "slot_id": "matches",
        "provider_uri": "watcher://matches",
        "content": {
          "type": "core://Column",
          "children": [
            {
              "type": "core://Row",
              "children": [
                {
                  "type": "core://Text",
                  "value_expr": "Upcoming matches",
                  "style": "Title"
                },
                {
                  "type": "core://Spacer"
                },
                {
                  "type": "core://Button",
                  "label": "Sites & rules",
                  "on_click": {
                    "intent": "action.navigation.open",
                    "presentation": "Push",
                    "target_uri": "watcher://setup"
                  }
                }
              ],
              "padding_h_dp": 16,
              "padding_v_dp": 8,
              "align": "Center"
            },
            {
              "type": "core://List",
              "query_key": "watcher:matches",
              "empty_text": "No matching events yet. Add a website and a rule under Sites & rules.",
              "item_template": {
                "type": "core://Tappable",
                "on_click": {
                  "intent": "action.navigation.open",
                  "presentation": "Push",
                  "target_uri": "watcher://events/$item.id"
                },
                "content": {
                  "type": "core://Column",
                  "children": [
                    {
                      "type": "core://Row",
                      "children": [
                        {
                          "type": "core://Container",
                          "orientation": "Vertical",
                          "padding_dp": 0,
                          "children": [
                            {
                              "type": "core://Text",
                              "value_expr": "$item.title",
                              "style": "Label"
                            }
                          ]
                        },
                        {
                          "type": "core://Spacer"
                        },
                        {
                          "type": "core://Conditional",
                          "value": "$item.seen",
                          "content": {
                            "type": "core://Chip",
                            "text": "New"
                          },
                          "equals": "false"
                        }
                      ],
                      "spacing_dp": 8,
                      "align": "Center"
                    },
                    {
                      "type": "core://Text",
                      "value_expr": "$item.meta",
                      "style": "Secondary"
                    },
                    {
                      "type": "core://Conditional",
                      "value": "$item.rules_text",
                      "content": {
                        "type": "core://Text",
                        "value_expr": "$item.rules_text",
                        "style": "Caption"
                      }
                    }
                  ],
                  "spacing_dp": 2,
                  "padding_h_dp": 16,
                  "padding_v_dp": 10
                },
                "content_description": "Open $item.title"
              }
            }
          ],
          "spacing_dp": 4
        }
      }
    ],
    "screens": [
      {
        "id": "event",
        "route": "watcher://events/{id}",
        "title": "${watcher://events/$route.id#source}",
        "data": "/v1/watcher/screens/event?id=$route.id",
        "content": {
          "type": "core://Column",
          "children": [
            {
              "type": "core://Text",
              "value_expr": "${watcher://events/$route.id#title}",
              "style": "Display"
            },
            {
              "type": "core://Text",
              "value_expr": "${watcher://events/$route.id#when_text}",
              "style": "Title"
            },
            {
              "type": "core://Text",
              "value_expr": "${watcher://events/$route.id#venue}",
              "style": "Body"
            },
            {
              "type": "core://Conditional",
              "value": "${watcher://events/$route.id#rules_text}",
              "content": {
                "type": "core://Text",
                "value_expr": "${watcher://events/$route.id#rules_text}",
                "style": "Secondary"
              }
            },
            {
              "type": "core://Divider"
            },
            {
              "type": "core://Text",
              "value_expr": "${watcher://events/$route.id#description}",
              "style": "Body"
            },
            {
              "type": "core://Conditional",
              "value": "${watcher://events/$route.id#url}",
              "content": {
                "type": "core://Column",
                "children": [
                  {
                    "type": "core://Text",
                    "value_expr": "Event page",
                    "style": "Label"
                  },
                  {
                    "type": "core://Text",
                    "value_expr": "${watcher://events/$route.id#url}",
                    "style": "Secondary"
                  }
                ],
                "spacing_dp": 2
              }
            },
            {
              "type": "core://Conditional",
              "value": "${watcher://events/$route.id#seen}",
              "content": {
                "type": "core://Button",
                "label": "Mark as seen",
                "on_click": {
                  "intent": "action.mutation.optimistic",
                  "entity_uri": "watcher://events/$route.id",
                  "field": "seen",
                  "value_expr": "true",
                  "rollback_value": false,
                  "endpoint": "/v1/watcher/events/seen",
                  "payload": {
                    "id": "$route.id",
                    "seen": "$value"
                  }
                }
              },
              "equals": "false"
            }
          ],
          "spacing_dp": 10,
          "padding_h_dp": 16,
          "padding_v_dp": 16
        }
      },
      {
        "id": "target",
        "route": "watcher://targets/{id}",
        "title": "${watcher://targets/$route.id#title}",
        "data": "/v1/watcher/screens/target?id=$route.id",
        "content": {
          "type": "core://Column",
          "children": [
            {
              "type": "core://Column",
              "children": [
                {
                  "type": "core://Text",
                  "value_expr": "${watcher://targets/$route.id#health_text}",
                  "style": "Body"
                },
                {
                  "type": "core://Text",
                  "value_expr": "${watcher://targets/$route.id#url}",
                  "style": "Secondary"
                },
                {
                  "type": "core://Text",
                  "value_expr": "${watcher://targets/$route.id#meta}",
                  "style": "Caption"
                },
                {
                  "type": "core://Row",
                  "children": [
                    {
                      "type": "core://Button",
                      "label": "Check now",
                      "on_click": {
                        "intent": "action.mutation.optimistic",
                        "entity_uri": "watcher://targets/$route.id",
                        "field": "refreshing",
                        "value_expr": "true",
                        "rollback_value": false,
                        "endpoint": "/v1/watcher/targets/refresh",
                        "payload": {
                          "id": "$route.id"
                        }
                      }
                    },
                    {
                      "type": "core://Button",
                      "label": "Stop watching",
                      "on_click": {
                        "intent": "action.mutation.optimistic",
                        "entity_uri": "watcher://targets/$route.id",
                        "field": "archived",
                        "value_expr": "true",
                        "rollback_value": false,
                        "endpoint": "/v1/watcher/targets/update",
                        "payload": {
                          "id": "$route.id",
                          "archived": "$value"
                        }
                      }
                    }
                  ],
                  "spacing_dp": 8
                },
                {
                  "type": "core://Conditional",
                  "value": "${watcher://targets/$route.id#archived}",
                  "content": {
                    "type": "core://Text",
                    "value_expr": "Archived: no longer checked.",
                    "style": "Secondary"
                  },
                  "equals": "true"
                },
                {
                  "type": "core://Spacer",
                  "size_dp": 8
                },
                {
                  "type": "core://Text",
                  "value_expr": "Upcoming events",
                  "style": "Title"
                }
              ],
              "spacing_dp": 6,
              "padding_h_dp": 16,
              "padding_v_dp": 12
            },
            {
              "type": "core://List",
              "query_key": "watcher:target:$route.id:events",
              "empty_text": "No upcoming events found on this page.",
              "item_template": {
                "type": "core://Tappable",
                "on_click": {
                  "intent": "action.navigation.open",
                  "presentation": "Push",
                  "target_uri": "watcher://events/$item.id"
                },
                "content": {
                  "type": "core://Column",
                  "children": [
                    {
                      "type": "core://Text",
                      "value_expr": "$item.title",
                      "style": "Label"
                    },
                    {
                      "type": "core://Text",
                      "value_expr": "$item.meta",
                      "style": "Secondary"
                    },
                    {
                      "type": "core://Conditional",
                      "value": "$item.rules_text",
                      "content": {
                        "type": "core://Text",
                        "value_expr": "$item.rules_text",
                        "style": "Caption"
                      }
                    }
                  ],
                  "spacing_dp": 2,
                  "padding_h_dp": 16,
                  "padding_v_dp": 8
                },
                "content_description": "Open $item.title"
              }
            }
          ]
        }
      },
      {
        "id": "setup",
        "route": "watcher://setup",
        "title": "Sites & rules",
        "content": {
          "type": "core://Column",
          "children": [
            {
              "type": "core://Column",
              "children": [
                {
                  "type": "core://Text",
                  "value_expr": "Websites",
                  "style": "Title"
                },
                {
                  "type": "core://Text",
                  "value_expr": "Pages listing events, or calendar (.ics) feeds. Each is checked every few hours.",
                  "style": "Secondary"
                }
              ],
              "spacing_dp": 2,
              "padding_h_dp": 16,
              "padding_v_dp": 8
            },
            {
              "type": "core://List",
              "query_key": "watcher:targets",
              "where": {
                "field": "archived",
                "equals": "false"
              },
              "empty_text": "No websites yet.",
              "item_template": {
                "type": "core://Tappable",
                "on_click": {
                  "intent": "action.navigation.open",
                  "presentation": "Push",
                  "target_uri": "watcher://targets/$item.id"
                },
                "content": {
                  "type": "core://Column",
                  "children": [
                    {
                      "type": "core://Row",
                      "children": [
                        {
                          "type": "core://Container",
                          "orientation": "Vertical",
                          "padding_dp": 0,
                          "children": [
                            {
                              "type": "core://Text",
                              "value_expr": "$item.title",
                              "style": "Label"
                            }
                          ]
                        },
                        {
                          "type": "core://Spacer"
                        },
                        {
                          "type": "core://Conditional",
                          "value": "$item.failing",
                          "content": {
                            "type": "core://Chip",
                            "text": "Needs attention",
                            "icon": "warning",
                            "tone": "Warning"
                          },
                          "equals": "true"
                        }
                      ],
                      "spacing_dp": 8,
                      "align": "Center"
                    },
                    {
                      "type": "core://Text",
                      "value_expr": "$item.health_text",
                      "style": "Secondary"
                    }
                  ],
                  "spacing_dp": 2,
                  "padding_h_dp": 16,
                  "padding_v_dp": 8
                },
                "content_description": "Open $item.title"
              }
            },
            {
              "type": "core://Column",
              "children": [
                {
                  "type": "core://TextField",
                  "field": "url",
                  "placeholder": "https://… events page or .ics feed"
                },
                {
                  "type": "core://Button",
                  "label": "Watch this page",
                  "on_click": {
                    "intent": "action.mutation.create",
                    "query_key": "watcher:targets",
                    "entity_uri": "watcher://targets/pending-$nonce",
                    "entity": {
                      "id": "pending-$nonce",
                      "title": "$form.url",
                      "health_text": "Not checked yet",
                      "failing": false,
                      "archived": false
                    },
                    "endpoint": "/v1/watcher/targets/create",
                    "payload": {
                      "url": "$form.url",
                      "client_id": "$nonce"
                    },
                    "refresh_workspace": true
                  }
                }
              ],
              "spacing_dp": 8,
              "padding_h_dp": 16,
              "padding_v_dp": 8
            },
            {
              "type": "core://Divider"
            },
            {
              "type": "core://Column",
              "children": [
                {
                  "type": "core://Text",
                  "value_expr": "Rules",
                  "style": "Title"
                },
                {
                  "type": "core://Text",
                  "value_expr": "You get a notification when a new event matches a rule.",
                  "style": "Secondary"
                }
              ],
              "spacing_dp": 2,
              "padding_h_dp": 16,
              "padding_v_dp": 8
            },
            {
              "type": "core://List",
              "query_key": "watcher:rules",
              "where": {
                "field": "archived",
                "equals": "false"
              },
              "empty_text": "No rules yet.",
              "item_template": {
                "type": "core://Row",
                "children": [
                  {
                    "type": "core://Container",
                    "orientation": "Vertical",
                    "padding_dp": 0,
                    "children": [
                      {
                        "type": "core://Text",
                        "value_expr": "$item.title",
                        "style": "Label"
                      },
                      {
                        "type": "core://Text",
                        "value_expr": "$item.summary",
                        "style": "Secondary"
                      }
                    ]
                  },
                  {
                    "type": "core://Spacer"
                  },
                  {
                    "type": "core://IconButton",
                    "icon": "close",
                    "content_description": "Remove rule $item.title",
                    "on_click": {
                      "intent": "action.mutation.optimistic",
                      "entity_uri": "$item.uri",
                      "field": "archived",
                      "value_expr": "true",
                      "rollback_value": false,
                      "endpoint": "/v1/watcher/rules/update",
                      "payload": {
                        "id": "$item.id",
                        "archived": "$value"
                      }
                    }
                  }
                ],
                "spacing_dp": 12,
                "padding_h_dp": 16,
                "padding_v_dp": 6,
                "align": "Center"
              }
            },
            {
              "type": "core://Column",
              "children": [
                {
                  "type": "core://TextField",
                  "field": "rule_keywords",
                  "placeholder": "Events mentioning… (e.g. Budget Cuts)"
                },
                {
                  "type": "core://TextField",
                  "field": "rule_exclude",
                  "placeholder": "…but not (e.g. class, workshop)"
                },
                {
                  "type": "core://Button",
                  "label": "Add rule",
                  "on_click": {
                    "intent": "action.mutation.create",
                    "query_key": "watcher:rules",
                    "entity_uri": "watcher://rules/pending-$nonce",
                    "entity": {
                      "id": "pending-$nonce",
                      "title": "$form.rule_keywords",
                      "summary": "\"$form.rule_keywords\"",
                      "archived": false
                    },
                    "endpoint": "/v1/watcher/rules/create",
                    "payload": {
                      "keywords": "$form.rule_keywords",
                      "exclude": "$form.rule_exclude",
                      "client_id": "$nonce"
                    },
                    "refresh_workspace": true
                  }
                }
              ],
              "spacing_dp": 8,
              "padding_h_dp": 16,
              "padding_v_dp": 8
            }
          ],
          "spacing_dp": 4
        }
      }
    ]
  }
}
