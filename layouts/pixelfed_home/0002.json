{
  "note": "Comments: the comment button opens the post's comments, where you can add one",
  "schema": 2,
  "layout": {
    "type": "core://Workspace",
    "id": "pixelfed_home",
    "slots": [
      {
        "content": {
          "type": "pixelfed://FeedList",
          "item_template": {
            "type": "pixelfed://PostCard",
            "action_slot": {
              "type": "pixelfed://ActionBar",
              "bookmark_intent": {
                "intent": "action.mutation.optimistic",
                "endpoint": "/v1/pixelfed/posts/bookmark",
                "entity_uri": "$item.uri",
                "field": "is_bookmarked",
                "payload": {
                  "bookmarked": "$value",
                  "id": "$item.id"
                },
                "rollback_value": false,
                "value_expr": "!entity.is_bookmarked"
              },
              "comment_intent": {
                "intent": "action.navigation.open",
                "presentation": "Modal",
                "target_uri": "pixelfed://posts/$item.id/comments"
              },
              "like_intent": {
                "intent": "action.mutation.optimistic",
                "also": [
                  {
                    "field": "like_count",
                    "value_expr": "entity.is_liked ? entity.like_count - 1 : entity.like_count + 1"
                  }
                ],
                "endpoint": "/v1/pixelfed/posts/like",
                "entity_uri": "$item.uri",
                "field": "is_liked",
                "payload": {
                  "id": "$item.id",
                  "liked": "$value"
                },
                "rollback_value": false,
                "value_expr": "!entity.is_liked"
              }
            },
            "author_slot": {
              "type": "pixelfed://AuthorHeader",
              "user_ref": "$item.author_uri"
            },
            "caption_slot": {
              "type": "core://Text",
              "style": "Body",
              "value_expr": "entity.caption"
            },
            "media_slot": {
              "type": "pixelfed://MediaCarousel",
              "aspect_ratio": 1.0,
              "media_refs": "$item.media_uris"
            },
            "post_ref": "$item.uri"
          },
          "query_key": "timeline:home"
        },
        "provider_uri": "pixelfed://home_timeline",
        "slot_id": "feed"
      }
    ],
    "title": "Pixelfed",
    "screens": [
      {
        "id": "comments",
        "route": "pixelfed://posts/{id}/comments",
        "title": "Comments",
        "data": "/v1/pixelfed/screens/comments?post_id=$route.id",
        "content": {
          "type": "core://List",
          "query_key": "comments:$route.id",
          "empty_text": "No comments yet. Be the first!",
          "indent": {
            "field": "depth",
            "step_dp": 24,
            "max": 4
          },
          "item_template": {
            "type": "core://Container",
            "orientation": "Vertical",
            "padding_dp": 8,
            "children": [
              {
                "type": "core://Container",
                "orientation": "Horizontal",
                "padding_dp": 0,
                "children": [
                  {
                    "type": "core://Image",
                    "url": "$item.avatar_url",
                    "shape": "Circle",
                    "size_dp": 28,
                    "content_description": "$item.author_name"
                  },
                  {
                    "type": "core://Text",
                    "value_expr": "$item.author_name",
                    "style": "Body"
                  }
                ]
              },
              {
                "type": "core://Text",
                "value_expr": "$item.text",
                "style": "Body"
              },
              {
                "type": "core://Text",
                "value_expr": "$item.meta",
                "style": "Caption"
              }
            ]
          }
        },
        "footer": {
          "type": "core://TextField",
          "field": "comment",
          "placeholder": "Add a comment…",
          "max_length": 500,
          "on_submit": {
            "intent": "action.mutation.create",
            "query_key": "comments:$route.id",
            "entity_uri": "pixelfed://comments/pending-$nonce",
            "entity": {
              "author_name": "You",
              "text": "$form.comment",
              "meta": "Sending…",
              "depth": 0
            },
            "endpoint": "/v1/pixelfed/posts/comment",
            "payload": {
              "id": "$route.id",
              "text": "$form.comment",
              "client_id": "$nonce"
            },
            "refresh_workspace": true
          }
        }
      }
    ]
  }
}
