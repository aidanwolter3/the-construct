{
  "note": "Recipes: the collection by category; a recipe screen with ingredients, steps and notes",
  "schema": 3,
  "layout": {
    "type": "core://Workspace",
    "id": "recipes",
    "title": "Recipes",
    "slots": [
      {
        "slot_id": "recipes",
        "provider_uri": "recipes://all",
        "content": {
          "type": "core://List",
          "query_key": "recipes:all",
          "empty_text": "No recipes yet",
          "item_template": {
            "type": "core://Column",
            "children": [
              {
                "type": "core://Conditional",
                "value": "$item.category_header",
                "content": {
                  "type": "core://Column",
                  "padding_h_dp": 16,
                  "padding_v_dp": 8,
                  "children": [
                    {
                      "type": "core://Spacer",
                      "size_dp": 8
                    },
                    {
                      "type": "core://Text",
                      "value_expr": "$item.category_header",
                      "style": "Title"
                    }
                  ]
                }
              },
              {
                "type": "core://Column",
                "padding_h_dp": 16,
                "padding_v_dp": 4,
                "children": [
                  {
                    "type": "core://Text",
                    "value_expr": "$item.title",
                    "style": "Label"
                  }
                ]
              },
              {
                "type": "core://Row",
                "spacing_dp": 12,
                "padding_h_dp": 16,
                "padding_v_dp": 4,
                "children": [
                  {
                    "type": "core://Text",
                    "value_expr": "$item.yield_text",
                    "style": "Secondary"
                  },
                  {
                    "type": "core://Spacer"
                  },
                  {
                    "type": "core://Button",
                    "label": "View",
                    "on_click": {
                      "intent": "action.navigation.open",
                      "presentation": "Push",
                      "target_uri": "recipes://recipes/$item.id"
                    }
                  }
                ]
              },
              {
                "type": "core://Divider"
              }
            ]
          }
        }
      }
    ],
    "screens": [
      {
        "id": "recipe",
        "route": "recipes://recipes/{id}",
        "title": "${recipes://recipes/$route.id#title}",
        "data": "/v1/recipes/screens/recipe?id=$route.id",
        "content": {
          "type": "core://Column",
          "spacing_dp": 4,
          "padding_h_dp": 16,
          "padding_v_dp": 8,
          "children": [
            {
              "type": "core://Text",
              "value_expr": "${recipes://recipes/$route.id#summary}",
              "style": "Secondary"
            },
            {
              "type": "core://List",
              "query_key": "recipe:$route.id:ingredients",
              "item_template": {
                "type": "core://Column",
                "children": [
                  {
                    "type": "core://Conditional",
                    "value": "$item.section",
                    "content": {
                      "type": "core://Column",
                      "padding_v_dp": 8,
                      "children": [
                        {
                          "type": "core://Text",
                          "value_expr": "$item.section",
                          "style": "Title"
                        }
                      ]
                    }
                  },
                  {
                    "type": "core://Conditional",
                    "value": "$item.group",
                    "content": {
                      "type": "core://Column",
                      "padding_v_dp": 4,
                      "children": [
                        {
                          "type": "core://Text",
                          "value_expr": "$item.group",
                          "style": "Label"
                        }
                      ]
                    }
                  },
                  {
                    "type": "core://Text",
                    "value_expr": "•  $item.text",
                    "style": "Body"
                  }
                ]
              }
            },
            {
              "type": "core://List",
              "query_key": "recipe:$route.id:steps",
              "item_template": {
                "type": "core://Column",
                "children": [
                  {
                    "type": "core://Conditional",
                    "value": "$item.section",
                    "content": {
                      "type": "core://Column",
                      "padding_v_dp": 8,
                      "children": [
                        {
                          "type": "core://Spacer",
                          "size_dp": 8
                        },
                        {
                          "type": "core://Text",
                          "value_expr": "$item.section",
                          "style": "Title"
                        }
                      ]
                    }
                  },
                  {
                    "type": "core://Conditional",
                    "value": "$item.group",
                    "content": {
                      "type": "core://Column",
                      "padding_v_dp": 4,
                      "children": [
                        {
                          "type": "core://Text",
                          "value_expr": "$item.group",
                          "style": "Label"
                        }
                      ]
                    }
                  },
                  {
                    "type": "core://Column",
                    "padding_v_dp": 3,
                    "children": [
                      {
                        "type": "core://Text",
                        "value_expr": "$item.number.  $item.text",
                        "style": "Body"
                      }
                    ]
                  }
                ]
              }
            },
            {
              "type": "core://List",
              "query_key": "recipe:$route.id:notes",
              "item_template": {
                "type": "core://Column",
                "children": [
                  {
                    "type": "core://Conditional",
                    "value": "$item.section",
                    "content": {
                      "type": "core://Column",
                      "padding_v_dp": 8,
                      "children": [
                        {
                          "type": "core://Spacer",
                          "size_dp": 8
                        },
                        {
                          "type": "core://Text",
                          "value_expr": "$item.section",
                          "style": "Title"
                        }
                      ]
                    }
                  },
                  {
                    "type": "core://Text",
                    "value_expr": "$item.text",
                    "style": "Body"
                  }
                ]
              }
            },
            {
              "type": "core://Spacer",
              "size_dp": 12
            },
            {
              "type": "core://Text",
              "value_expr": "Source: ${recipes://recipes/$route.id#source}",
              "style": "Caption"
            }
          ]
        }
      }
    ]
  }
}
