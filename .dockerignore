# Build context (the repo root) for deploy/pod.Dockerfile and fake-pixelfed/Dockerfile:
# keep it small (target/ alone is many GB).
target
**/target
.git
app
dev
docs
**/*.swp
# Images build with the Rust in their pinned base image; rust-toolchain.toml would
# make rustup download another toolchain mid-build.
rust-toolchain.toml
