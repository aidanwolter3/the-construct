{
  "layouts": {
    "home": {
      "type": "core://Page",
      "id": "home",
      "title": "Home",
      "root": {
        "type": "core://Column",
        "padding_v_dp": 12,
        "spacing_dp": 8,
        "children": [
          {
            "type": "core://Text",
            "style": "Headline",
            "value_expr": "Home"
          },
          {
            "type": "core://Tappable",
            "content_description": "Recipes",
            "on_click": {
              "intent": "action.navigation.open",
              "layout": "c-recipes",
              "presentation": "Push"
            },
            "content": {
              "type": "core://Column",
              "padding_h_dp": 16,
              "padding_v_dp": 12,
              "children": [
                {
                  "type": "core://Text",
                  "style": "Title",
                  "value_expr": "Recipes"
                },
                {
                  "type": "core://Text",
                  "style": "Secondary",
                  "value_expr": "Open the recipe book"
                }
              ]
            }
          }
        ],
        "padding_h_dp": 16
      }
    },
    "c-recipes": {
      "type": "core://Page",
      "id": "c-recipes",
      "title": "Recipes (edited)",
      "root": {
        "type": "core://Column",
        "children": [
          {
            "type": "core://Row",
            "padding_h_dp": 8,
            "spacing_dp": 4,
            "children": [
              {
                "type": "core://IconButton",
                "icon": "arrow_back",
                "content_description": "Back",
                "on_click": {
                  "intent": "action.navigation.back"
                }
              },
              {
                "type": "core://Text",
                "style": "Title",
                "value_expr": "Recipes (edited)"
              }
            ]
          },
          {
            "type": "core://Column",
            "padding_h_dp": 16,
            "children": [
              {
                "type": "core://TextField",
                "field": "note",
                "placeholder": "A note for tonight"
              }
            ]
          },
          {
            "type": "core://Scroll",
            "content": {
              "type": "core://List",
              "query_key": "sim:items",
              "item_template": {
                "type": "core://Tappable",
                "content_description": "$item.title",
                "on_click": {
                  "intent": "action.navigation.open",
                  "layout": "c-detail",
                  "presentation": "Push"
                },
                "content": {
                  "type": "core://Column",
                  "padding_h_dp": 16,
                  "padding_v_dp": 10,
                  "children": [
                    {
                      "type": "core://Text",
                      "style": "Body",
                      "value_expr": "$item.title"
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "c-detail": {
      "type": "core://Page",
      "id": "c-detail",
      "title": "Detail",
      "root": {
        "type": "core://Column",
        "padding_h_dp": 16,
        "children": [
          {
            "type": "core://Text",
            "style": "Title",
            "value_expr": "Detail"
          }
        ]
      }
    }
  },
  "reach": {
    "home": [
      "c-recipes"
    ],
    "c-recipes": [
      "c-detail"
    ],
    "c-detail": []
  },
