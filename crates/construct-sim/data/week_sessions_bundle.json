                              {
                                "type": "core://Text",
                                "style": "Caption",
                                "value_expr": "$item.short"
                              }
                            ]
                          }
                        }
                      }
                    },
                    {
                      "type": "core://Conditional",
                      "value": "$item.date",
                      "time": "$item.ends",
                      "date": "Future",
                      "content": {
                        "type": "core://Box",
                        "align": "Center",
                        "background": "${local://theme#page}",
                        "border_color": "${local://theme#card_border}",
                        "content_color": "${local://theme#muted_text}",
                        "corner_dp": 12,
                        "height_dp": 100,
                        "width_dp": 172,
                        "content": {
                          "type": "core://Column",
                          "align": "Center",
                          "spacing_dp": 2,
                          "children": [
                            {
                              "type": "core://Text",
