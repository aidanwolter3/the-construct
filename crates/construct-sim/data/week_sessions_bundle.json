                            {
                              "type": "core://Text",
                              "style": "Caption",
                              "value_expr": "$item.short"
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            ]
          },
          "where": [
            {
              "field": "deleted",
              "equals": "false"
            },
            {
