  "c-recipe": {
   "type": "core://Page",
   "id": "c-recipe",
   "title": "Recipe",
   "root": {
    "type": "core://Box",
    "fill": true,
    "background": "${local://theme#page}",
    "content": {
     "type": "core://Column",
     "children": [
      {
       "type": "core://Row",
       "align": "Center",
       "padding_h_dp": 16,
       "padding_v_dp": 8,
       "spacing_dp": 4,
       "children": [
        {
         "type": "core://IconButton",
         "icon": "arrow_back",
         "content_description": "Back",
         "on_click": {
          "intent": "action.navigation.back"
         }
        },
        {
         "type": "core://Text",
         "style": "Headline",
         "value_expr": "$route.name"
        }
       ]
      },
      {
       "type": "core://Scroll",
       "content": {
        "type": "core://Column",
        "padding_h_dp": 16,
        "padding_v_dp": 8,
        "spacing_dp": 12,
        "children": [
         {
          "type": "core://Text",
          "style": "Title",
          "value_expr": "Recipe: $route.name"
         },
         {
          "type": "core://Text",
          "style": "Body",
          "value_expr": "Serves 4. What goes in it, and the steps, would be here."
         }
        ]
       }
      }
     ]
    }
   }
  }
 },
 "reach": {
  "home": [
   "c-meals"
  ],
  "c-meals": [
