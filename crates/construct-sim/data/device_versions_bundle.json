{
 "version": "1.0.0",
 "workspace": {
  "type": "core://Page",
  "id": "device_versions",
  "title": "Server health",
  "root": {
   "type": "core://Box",
   "fill": true,
   "background": "${local://theme#page}",
   "content": {
    "type": "core://Scroll",
    "content": {
     "type": "core://Column",
     "spacing_dp": 12,
     "padding_h_dp": 16,
     "padding_v_dp": 16,
     "children": [
      {
       "type": "core://Text",
       "style": "Display",
       "value_expr": "Server health",
       "weight": "SemiBold"
      },
      {
       "type": "core://Column",
       "children": [
        {
         "type": "core://Row",
         "children": [
          {
           "type": "core://Text",
           "style": "Label",
           "value_expr": "Devices"
          },
          {
           "type": "core://Spacer"
          },
          {
           "type": "core://Box",
           "content_color": "${local://theme#muted_text}",
           "content": {
            "type": "core://Text",
            "style": "Caption",
            "value_expr": "${monitor://device_summary/pod#count_text}"
           }
          }
         ],
         "align": "Center"
        },
        {
         "type": "core://Box",
         "content_color": "${local://theme#muted_text}",
         "content": {
          "type": "core://Text",
          "style": "Caption",
          "value_expr": "${monitor://device_summary/pod#status_text}"
         }
        },
        {
         "type": "core://ChoiceChips",
         "field": "device_kind",
         "options": [
          {
           "value": "",
           "label": "All"
          },
          {
           "value": "android",
           "label": "Phone"
          },
          {
           "value": "macos",
           "label": "Mac"
          },
          {
           "value": "web",
           "label": "Web"
          }
         ]
        },
        {
         "type": "core://Box",
         "background": "${local://theme#card}",
         "border_color": "${local://theme#card_border}",
         "corner_dp": 16,
         "padding_h_dp": 14,
         "padding_v_dp": 14,
         "content": {
          "type": "core://Column",
          "children": [
           {
            "type": "core://Row",
            "children": [
             {
              "type": "core://Text",
              "style": "Label",
              "value_expr": "Devices per day"
             },
             {
              "type": "core://Spacer"
             },
             {
              "type": "core://Box",
              "content_color": "${local://theme#muted_text}",
              "content": {
               "type": "core://Text",
               "style": "Caption",
               "value_expr": "last 14 days"
              }
             }
            ],
            "align": "Center"
           },
           {
            "type": "core://Bars",
            "query_key": "monitor:device_days",
            "bar": "bar",
            "label": "$item.bar_label",
            "color": "$item.color",
            "hatched": "hatched",
            "where": {
             "field": "kind",
             "equals": "$form.device_kind"
            },
            "field": "device_day",
            "scale_min": 5,
            "height_dp": 140
           },
           {
            "type": "core://List",
            "query_key": "monitor:builds",
            "columns": 2,
            "spacing_dp": 4,
            "item_template": {
             "type": "core://Row",
             "children": [
              {
               "type": "core://Box",
               "background": "$item.color",
               "corner_dp": 3,
               "width_dp": 10,
               "height_dp": 10,
               "content": {
                "type": "core://Spacer"
               }
              },
              {
               "type": "core://Box",
               "content_color": "${local://theme#muted_text}",
               "content": {
                "type": "core://Text",
                "style": "Caption",
                "value_expr": "$item.legend"
               }
              }
             ],
             "spacing_dp": 6,
             "align": "Center"
            }
           },
           {
            "type": "core://Column",
            "children": [
             {
              "type": "core://Divider"
             },
             {
              "type": "core://Conditional",
              "value": "$form.device_day",
              "content": {
               "type": "core://List",
               "query_key": "monitor:device_days",
               "where": [
                {
                 "field": "bar",
                 "equals": "$form.device_day"
                },
                {
                 "field": "kind",
                 "equals": "$form.device_kind"
                }
               ],
               "spacing_dp": 6,
               "item_template": {
                "type": "core://Row",
                "children": [
                 {
                  "type": "core://Box",
                  "background": "$item.color",
                  "corner_dp": 3,
                  "width_dp": 10,
                  "height_dp": 10,
                  "content": {
                   "type": "core://Spacer"
                  }
                 },
                 {
                  "type": "core://Text",
                  "style": "Body",
                  "value_expr": "$item.device"
                 },
                 {
                  "type": "core://Spacer"
                 },
                 {
                  "type": "core://Box",
                  "content_color": "${local://theme#muted_text}",
                  "content": {
                   "type": "core://Text",
                   "style": "Caption",
                   "value_expr": "$item.detail"
                  }
                 }
                ],
                "spacing_dp": 8,
                "align": "Center"
               },
               "group_by": {
                "field": "bar",
                "header": {
                 "type": "core://Text",
                 "style": "Label",
                 "value_expr": "$item.day_text"
                }
               }
              }
             },
             {
              "type": "core://Conditional",
              "value": "$form.device_day",
              "not": true,
              "content": {
               "type": "core://Column",
               "children": [
                {
                 "type": "core://Text",
                 "style": "Label",
                 "value_expr": "Now: every device at its latest build"
                },
                {
                 "type": "core://List",
                 "query_key": "monitor:device_days",
                 "where": [
                  {
                   "field": "bar",
                   "equals": "${monitor://device_summary/pod#today}"
                  },
                  {
                   "field": "kind",
                   "equals": "$form.device_kind"
                  }
                 ],
                 "spacing_dp": 6,
                 "item_template": {
                  "type": "core://Row",
                  "children": [
                   {
                    "type": "core://Box",
                    "background": "$item.color",
                    "corner_dp": 3,
                    "width_dp": 10,
                    "height_dp": 10,
                    "content": {
                     "type": "core://Spacer"
                    }
                   },
                   {
                    "type": "core://Text",
                    "style": "Body",
                    "value_expr": "$item.device"
                   },
                   {
                    "type": "core://Spacer"
                   },
                   {
                    "type": "core://Box",
                    "content_color": "${local://theme#muted_text}",
                    "content": {
                     "type": "core://Text",
                     "style": "Caption",
                     "value_expr": "$item.detail"
                    }
                   }
                  ],
                  "spacing_dp": 8,
                  "align": "Center"
                 }
                }
               ],
               "spacing_dp": 6
              }
             }
            ],
            "spacing_dp": 10
           }
          ],
          "spacing_dp": 12
         }
        },
        {
         "type": "core://Box",
         "corner_dp": 16,
         "border_color": "${local://theme#card_border}",
         "content": {
          "type": "core://List",
          "query_key": "monitor:devices",
          "where": {
           "field": "kind",
           "equals": "$form.device_kind"
          },
          "spacing_dp": 1,
          "item_template": {
           "type": "core://Box",
           "background": "${local://theme#card}",
           "padding_h_dp": 14,
           "padding_v_dp": 12,
           "content": {
            "type": "core://Row",
            "children": [
             {
              "type": "core://Column",
              "children": [
               {
                "type": "core://Text",
                "style": "Body",
                "value_expr": "$item.name",
                "weight": "SemiBold"
               },
               {
                "type": "core://Box",
                "content_color": "${local://theme#muted_text}",
                "content": {
                 "type": "core://Text",
                 "style": "Caption",
                 "value_expr": "$item.subtitle"
                }
               }
              ],
              "spacing_dp": 2
             },
             {
              "type": "core://Spacer"
             },
             {
              "type": "core://Box",
              "background": "$item.relation_bg",
              "content_color": "$item.relation_color",
              "corner_dp": 10,
              "padding_h_dp": 9,
              "padding_v_dp": 3,
              "content": {
               "type": "core://Text",
               "style": "Caption",
               "value_expr": "$item.relation_text",
               "weight": "SemiBold"
              }
             }
            ],
            "spacing_dp": 10,
            "align": "Center"
           }
          }
         }
        }
       ],
       "spacing_dp": 10
      }
     ]
    }
   }
  }
 },
