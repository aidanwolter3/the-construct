{
 "note": "Exploring one need of the shopping kit through the taste service (decision shopping-kit): the kinds, then rounds narrowing toward what you like, and the shortlist to choose from",
 "layout": {
  "type": "core://Page",
  "id": "shopping_explore",
  "title": "Explore",
  "root": {
   "type": "core://Use",
   "component": "core:screen_scaffold",
   "args": {
    "title": "${collections://shop_needs/$route.need#name}"
   },
   "children": [
    {
     "type": "core://List",
     "query_key": "collection:shop_rounds",
     "item_template": {
      "type": "core://Row",
      "children": [
       {
        "type": "core://Use",
        "component": "core:pill",
        "args": {
         "text": "$item.title_text",
         "tone": "accent"
        }
       },
       {
        "type": "core://Use",
        "component": "core:muted_text",
        "args": {
         "text": "$item.label",
         "when": "$item.label"
        }
       },
       {
        "type": "core://Spacer"
       },
       {
        "type": "core://Conditional",
        "content": {
         "type": "core://Use",
         "component": "core:text_link",
         "args": {
          "label": "Back a round",
          "description": "Back to the round before",
          "on_click": {
           "intent": "action.mutation.optimistic",
           "entity_uri": "$item.uri",
           "field": "deleted",
           "value_expr": "true",
           "endpoint": "/v1/collections/shop_rounds/delete",
           "payload": {
            "id": "$item.id"
           }
          }
         }
        },
        "value": "$item.n",
        "equals": "0",
        "not": true
       }
      ],
      "spacing_dp": 8,
      "align": "Center"
     },
     "where": [
      {
       "field": "deleted",
       "equals": "false"
      },
      {
       "field": "need",
       "equals": "$route.need"
      },
      {
       "field": "current",
       "equals": "true"
      }
     ]
    },
    {
     "type": "core://List",
     "query_key": "collection:shop_needs",
     "item_template": {
      "type": "core://Column",
      "children": [
       {
        "type": "core://Conditional",
        "content": {
         "type": "core://Column",
         "children": [
          {
           "type": "core://Use",
           "component": "core:loading_spinner",
           "args": {}
          },
          {
           "type": "core://Use",
           "component": "core:muted_note",
           "args": {
            "text": "Finding pieces…"
           }
          }
         ],
         "spacing_dp": 8,
         "align": "Center"
        },
        "not": true,
        "count": {
         "query_key": "collection:shop_pieces",
         "where": [
          {
           "field": "deleted",
           "equals": "false"
          },
          {
           "field": "need",
           "equals": "$route.need"
          },
          {
           "field": "current",
           "equals": "true"
          }
         ]
        }
       },
       {
        "type": "core://Conditional",
        "content": {
         "type": "core://Column",
         "children": [
          {
           "type": "core://Use",
           "component": "core:muted_text",
           "args": {
            "text": "These are the kinds of $item.name. Go the way you like."
           }
          },
          {
           "type": "core://List",
           "query_key": "collection:shop_pieces",
           "item_template": {
            "type": "core://Tappable",
            "content_description": "Open $item.title",
            "on_click": {
             "intent": "action.link.open",
             "url": "$item.url"
            },
            "content": {
             "type": "core://Image",
             "url": "$item.image",
             "aspect_ratio": 0.75,
             "shape": "Rounded",
             "content_description": "$item.title"
            }
           },
           "where": [
            {
             "field": "deleted",
             "equals": "false"
            },
            {
             "field": "need",
             "equals": "$route.need"
            },
            {
             "field": "current",
             "equals": "true"
            }
           ],
           "columns": 4,
           "spacing_dp": 6,
           "group_by": {
            "field": "group_label",
            "header": {
             "type": "core://Column",
             "children": [
              {
               "type": "core://Row",
               "children": [
                {
                 "type": "core://Column",
                 "children": [
                  {
                   "type": "core://Text",
                   "value_expr": "$item.group_label",
                   "style": "Label",
                   "weight": "SemiBold"
                  },
                  {
                   "type": "core://Use",
                   "component": "core:muted_text",
                   "args": {
                    "text": "$item.group_size · $item.group_prices",
                    "style": "Caption"
                   }
                  }
                 ],
                 "spacing_dp": 2,
                 "fill": true
                },
                {
                 "type": "core://Use",
                 "component": "core:button",
                 "args": {
                  "label": "Go this way",
                  "on_click": {
                   "intent": "action.sequence",
                   "steps": [
                    {
                     "intent": "action.mutation.create",
                     "query_key": "collection:shop_rounds",
                     "entity_uri": "collections://shop_rounds/pending-$nonce",
                     "entity": {
                      "id": "pending-$nonce",
                      "deleted": false,
                      "need": "$item.need",
                      "n": 1,
                      "like": "$item.group_ids",
                      "label": "$item.group_label",
                      "avoid": "$item.avoid",
                      "prefer": "$item.prefer"
                     },
                     "endpoint": "/v1/collections/shop_rounds/create",
                     "payload": {
                      "need": "$item.need",
                      "n": 1,
                      "like": "$item.group_ids",
                      "label": "$item.group_label",
                      "avoid": "$item.avoid",
                      "prefer": "$item.prefer",
                      "client_id": "$nonce"
                     },
                     "refresh_workspace": true
                    }
                   ]
                  },
                  "style": "Tonal",
                  "size": "Small"
                 }
                }
               ],
               "spacing_dp": 8,
               "align": "Center"
              }
             ],
             "spacing_dp": 0,
             "padding_v_dp": 6
            }
           }
          }
         ],
         "spacing_dp": 10
        },
        "value": "$item.round_count",
        "equals": "1"
       },
       {
        "type": "core://Conditional",
        "content": {
         "type": "core://Column",
         "children": [
          {
           "type": "core://Use",
           "component": "core:section_label",
           "args": {
            "text": "How far"
           }
          },
          {
           "type": "core://ChoiceChips",
           "field": "how_far",
           "options": [
            {
             "label": "Auto",
             "value": ""
            },
            {
             "label": "Closer",
             "value": "0.1"
            },
            {
             "label": "Similar",
             "value": "0.3"
            },
            {
             "label": "Different",
             "value": "0.6"
            },
            {
             "label": "Very different",
             "value": "0.9"
            }
           ]
          },
          {
           "type": "core://TextField",
           "field": "steer",
           "placeholder": "This, but… (in brass, lighter)"
          },
          {
           "type": "core://List",
           "query_key": "collection:shop_pieces",
           "item_template": {
            "type": "core://Use",
            "component": "core:card",
            "args": {
             "spacing": 4,
             "padding_h": 8,
             "padding_v": 8
            },
            "children": [
             {
              "type": "core://Tappable",
              "content_description": "Open $item.title",
              "on_click": {
               "intent": "action.link.open",
               "url": "$item.url"
              },
              "content": {
               "type": "core://Image",
               "url": "$item.image",
               "aspect_ratio": 0.8,
               "shape": "Rounded",
               "content_description": "$item.title"
              }
             },
             {
              "type": "core://Text",
              "value_expr": "$item.title",
              "style": "Caption",
              "weight": "SemiBold",
              "max_lines": 2
             },
             {
              "type": "core://Use",
              "component": "core:muted_text",
              "args": {
               "text": "$item.price_text · $item.brand",
               "style": "Caption",
               "max_lines": 1
              }
             },
             {
              "type": "core://Row",
              "children": [
               {
                "type": "core://Conditional",
                "content": {
                 "type": "core://IconButton",
                 "icon": "close",
                 "active_icon": "close",
                 "active": "false",
                 "content_description": "Not this",
                 "on_click": {
                  "intent": "action.mutation.optimistic",
                  "entity_uri": "$item.uri",
                  "field": "reaction",
                  "value_expr": "\"less\"",
                  "endpoint": "/v1/collections/shop_pieces/update",
                  "payload": {
                   "id": "$item.id",
                   "reaction": "$value"
                  }
                 }
                },
                "value": "$item.reaction",
                "equals": "less",
                "not": true
               },
               {
                "type": "core://Conditional",
                "content": {
                 "type": "core://IconButton",
                 "icon": "close",
                 "active_icon": "close",
                 "active": "true",
                 "content_description": "Not this (undo)",
                 "on_click": {
                  "intent": "action.mutation.optimistic",
                  "entity_uri": "$item.uri",
                  "field": "reaction",
                  "value_expr": "\"\"",
                  "endpoint": "/v1/collections/shop_pieces/update",
                  "payload": {
                   "id": "$item.id",
                   "reaction": "$value"
                  }
                 }
                },
                "value": "$item.reaction",
                "equals": "less"
               },
               {
                "type": "core://Spacer"
               },
               {
                "type": "core://IconButton",
                "icon": "bookmark_border",
                "active_icon": "bookmark",
                "active": "$item.shortlisted",
                "content_description": "Shortlist",
                "on_click": {
                 "intent": "action.mutation.optimistic",
                 "entity_uri": "$item.uri",
                 "field": "shortlisted",
                 "value_expr": "!entity.shortlisted",
                 "endpoint": "/v1/collections/shop_pieces/update",
                 "payload": {
                  "id": "$item.id",
                  "shortlisted": "$value"
                 }
                }
               },
               {
                "type": "core://Spacer"
               },
               {
                "type": "core://Conditional",
                "content": {
                 "type": "core://IconButton",
                 "icon": "favorite_border",
                 "active_icon": "favorite",
                 "active": "false",
                 "content_description": "More like this",
                 "on_click": {
                  "intent": "action.mutation.optimistic",
                  "entity_uri": "$item.uri",
                  "field": "reaction",
                  "value_expr": "\"more\"",
                  "endpoint": "/v1/collections/shop_pieces/update",
                  "payload": {
                   "id": "$item.id",
                   "reaction": "$value"
                  }
                 }
                },
                "value": "$item.reaction",
                "equals": "more",
                "not": true
               },
               {
                "type": "core://Conditional",
                "content": {
                 "type": "core://IconButton",
                 "icon": "favorite_border",
                 "active_icon": "favorite",
                 "active": "true",
                 "content_description": "More like this (undo)",
                 "on_click": {
                  "intent": "action.mutation.optimistic",
                  "entity_uri": "$item.uri",
                  "field": "reaction",
                  "value_expr": "\"\"",
                  "endpoint": "/v1/collections/shop_pieces/update",
                  "payload": {
                   "id": "$item.id",
                   "reaction": "$value"
                  }
                 }
                },
                "value": "$item.reaction",
                "equals": "more"
               }
              ],
              "spacing_dp": 0,
              "align": "Center"
             }
            ]
           },
           "where": [
            {
             "field": "deleted",
             "equals": "false"
            },
            {
             "field": "need",
             "equals": "$route.need"
            },
            {
             "field": "current",
             "equals": "true"
            }
           ],
           "columns": 2,
           "spacing_dp": 10
          },
          {
           "type": "core://Use",
           "component": "core:button",
           "args": {
            "label": "Next round",
            "on_click": {
             "intent": "action.mutation.create",
             "query_key": "collection:shop_rounds",
             "entity_uri": "collections://shop_rounds/pending-$nonce",
             "entity": {
              "id": "pending-$nonce",
              "deleted": false,
              "need": "$item.id",
              "n": "$item.round_count",
              "query": "$item.name $form.steer",
              "like": "$item.like_ids",
              "unlike": "$item.unlike_ids",
              "exclude": "$item.shown_ids",
              "how_far": "$form.how_far",
              "avoid": "$item.avoid",
              "prefer": "$item.prefer"
             },
             "endpoint": "/v1/collections/shop_rounds/create",
             "payload": {
              "need": "$item.id",
              "n": "$item.round_count",
              "query": "$item.name $form.steer",
              "like": "$item.like_ids",
              "unlike": "$item.unlike_ids",
              "exclude": "$item.shown_ids",
              "how_far": "$form.how_far",
              "avoid": "$item.avoid",
              "prefer": "$item.prefer",
              "client_id": "$nonce"
             },
             "refresh_workspace": true
            },
            "style": "Primary",
            "size": "Regular"
           }
          }
         ],
         "spacing_dp": 10
        },
        "value": "$item.round_count",
        "equals": "1",
        "not": true
       }
      ],
      "spacing_dp": 12
     },
     "where": [
      {
       "field": "id",
       "equals": "$route.need"
      }
     ]
    },
    {
     "type": "core://Conditional",
     "content": {
      "type": "core://Use",
      "component": "core:titled_section",
      "args": {
       "text": "Shortlist"
      },
      "children": [
       {
        "type": "core://List",
        "query_key": "collection:shop_pieces",
        "item_template": {
         "type": "core://Use",
         "component": "core:card",
         "args": {
          "spacing": 6,
          "padding_h": 10,
          "padding_v": 10
         },
         "children": [
          {
           "type": "core://Tappable",
           "content_description": "Open $item.title",
           "on_click": {
            "intent": "action.link.open",
            "url": "$item.url"
           },
           "content": {
            "type": "core://Image",
            "url": "$item.image",
            "aspect_ratio": 0.8,
            "shape": "Rounded",
            "content_description": "$item.title"
           }
          },
          {
           "type": "core://Text",
           "value_expr": "$item.title",
           "style": "Label",
           "weight": "SemiBold",
           "max_lines": 2
          },
          {
           "type": "core://Text",
           "value_expr": "$item.price_text",
           "style": "Title",
           "weight": "Bold"
          },
          {
           "type": "core://Use",
           "component": "core:muted_text",
           "args": {
            "text": "$item.brand · $item.host",
            "max_lines": 1
           }
          },
          {
           "type": "core://Use",
           "component": "core:muted_text",
           "args": {
            "text": "$item.description",
            "when": "$item.description",
            "max_lines": 3,
            "style": "Caption"
           }
          },
          {
           "type": "core://Row",
           "children": [
            {
             "type": "core://IconButton",
             "icon": "close",
             "active_icon": "close",
             "active": "false",
             "content_description": "Remove from the shortlist",
             "on_click": {
              "intent": "action.mutation.optimistic",
              "entity_uri": "$item.uri",
              "field": "shortlisted",
              "value_expr": "false",
              "endpoint": "/v1/collections/shop_pieces/update",
              "payload": {
               "id": "$item.id",
               "shortlisted": "$value"
              }
             }
            },
            {
             "type": "core://Spacer"
            },
            {
             "type": "core://Use",
             "component": "core:button",
             "args": {
              "label": "Choose this",
              "on_click": {
               "intent": "action.sequence",
               "steps": [
                {
                 "intent": "action.mutation.create",
                 "query_key": "collection:shop_picks",
                 "entity_uri": "collections://shop_picks/pending-$nonce",
                 "entity": {
                  "id": "pending-$nonce",
                  "deleted": false,
                  "need": "$item.need",
                  "product": "$item.title",
                  "brand": "$item.brand",
                  "store": "$item.host",
                  "url": "$item.url",
                  "image": "$item.image",
                  "taste_key": "$item.taste_key",
                  "chosen_price": "$item.price"
                 },
                 "endpoint": "/v1/collections/shop_picks/create",
                 "payload": {
                  "need": "$item.need",
                  "product": "$item.title",
                  "brand": "$item.brand",
                  "store": "$item.host",
                  "url": "$item.url",
                  "image": "$item.image",
                  "taste_key": "$item.taste_key",
                  "chosen_price": "$item.price",
                  "client_id": "$nonce"
                 },
                 "refresh_workspace": true
                },
                {
                 "intent": "action.mutation.optimistic",
                 "entity_uri": "$item.uri",
                 "field": "shortlisted",
                 "value_expr": "true",
                 "endpoint": "/v1/collections/shop_pieces/update",
                 "payload": {
                  "id": "$item.id",
                  "shortlisted": true
                 }
                },
                {
                 "intent": "action.navigation.pop_to",
                 "edge": "shopping_need"
                }
               ]
              },
              "style": "Primary",
              "size": "Small"
             }
            }
           ],
           "spacing_dp": 4,
           "align": "Center"
          }
         ]
        },
        "where": [
         {
          "field": "deleted",
          "equals": "false"
         },
         {
          "field": "need",
          "equals": "$route.need"
         },
         {
          "field": "shortlisted",
          "equals": "true"
         }
        ],
        "columns": 2,
        "spacing_dp": 10
       }
      ]
     },
     "count": {
      "query_key": "collection:shop_pieces",
      "where": [
       {
        "field": "deleted",
        "equals": "false"
       },
       {
        "field": "need",
        "equals": "$route.need"
       },
       {
        "field": "shortlisted",
        "equals": "true"
       }
      ]
     }
    }
   ]
  }
 }
}
