{
  "note": "Centred, labelled Notifications and Settings buttons and three ideas to ask the agent for (the icons sat at the left edge under centred text)",
  "layout": {
    "type": "core://Workspace",
    "id": "shell",
    "title": "The Construct",
    "slots": [
      {
        "slot_id": "home",
        "provider_uri": "local://home",
