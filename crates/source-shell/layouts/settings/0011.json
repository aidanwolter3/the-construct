{
  "note": "Settings says when changes aren't reaching the pod and which were given up (decision failing-saves-give-up)",
  "layout": {
    "type": "core://Workspace",
    "id": "settings",
    "title": "Settings",
    "slots": [
      {
        "slot_id": "connection",
        "provider_uri": "local://connection",
        "content": {
          "type": "core://Column",
          "children": [
            {
              "type": "core://Row",
              "spacing_dp": 8,
              "padding_h_dp": 16,
              "padding_v_dp": 8,
              "children": [
                {
                  "type": "core://Use",
                  "component": "core:dot",
                  "args": {
                    "color": "${local://connection#color}",
                    "size": 10,
                    "corner": 5
                  }
                },
                {
                  "type": "core://Text",
                  "style": "Body",
                  "value_expr": "${local://connection#label}"
                },
                {
                  "type": "core://Spacer"
                },
                {
                  "type": "core://Text",
                  "style": "Secondary",
                  "value_expr": "${local://session#server}"
                }
              ]
            },
            {
              "type": "core://Conditional",
              "value": "${local://connection#stuck}",
              "content": {
                "type": "core://Column",
                "padding_h_dp": 16,
                "padding_v_dp": 4,
                "spacing_dp": 2,
                "children": [
                  {
                    "type": "core://Text",
                    "style": "Body",
                    "weight": "SemiBold",
                    "value_expr": "Changes aren't reaching the pod"
                  },
                  {
                    "type": "core://Text",
                    "style": "Secondary",
                    "value_expr": "The pod answers: ${local://connection#error}. It keeps trying; a change it still refuses after a while is undone so the rest can be saved."
                  }
                ]
              }
            },
            {
              "type": "core://Conditional",
              "value": "${local://connection#dropped_text}",
              "content": {
                "type": "core://Box",
                "padding_h_dp": 16,
                "padding_v_dp": 4,
                "content": {
                  "type": "core://Text",
                  "style": "Secondary",
                  "value_expr": "${local://connection#dropped_text}. Undone on this device."
                }
              }
            }
          ]
        }
      },
      {
        "slot_id": "sign_ins",
        "provider_uri": "local://sign_ins",
        "content": {
          "type": "core://Column",
          "children": [
            {
              "type": "core://Use",
              "component": "core:section_header",
              "args": {
                "text": "Sign-ins",
                "divider": true
              }
            },
            {
              "type": "core://Conditional",
              "value": "${local://session#status}",
              "content": {
                "type": "core://Use",
                "component": "core:section_header",
                "args": {
                  "text": "${local://session#status}",
                  "style": "Secondary",
                  "padding_v": 4
                }
              }
            },
            {
              "type": "core://List",
              "query_key": "local:sign_ins",
              "item_template": {
                "type": "core://Row",
                "spacing_dp": 8,
                "padding_h_dp": 16,
                "padding_v_dp": 4,
                "children": [
                  {
                    "type": "core://Container",
                    "children": [
                      {
                        "type": "core://Text",
                        "style": "Body",
                        "value_expr": "$item.title"
                      },
                      {
                        "type": "core://Text",
                        "style": "Secondary",
                        "value_expr": "$item.detail"
                      }
                    ],
                    "orientation": "Vertical",
                    "padding_dp": 0
                  },
                  {
                    "type": "core://Spacer"
                  },
                  {
                    "type": "core://Button",
                    "label": "Sign out",
                    "on_click": {
                      "intent": "action.confirm",
                      "title": "Sign out of $item.title?",
                      "message": "You can sign in again here in Settings.",
                      "confirm_label": "Sign out",
                      "then": {
                        "intent": "action.device",
                        "command": "sign_out"
                      }
                    },
                    "style": "Secondary"
                  }
                ]
              }
            },
            {
              "type": "core://List",
              "query_key": "local:providers",
              "item_template": {
                "type": "core://Column",
                "padding_h_dp": 16,
                "padding_v_dp": 4,
                "spacing_dp": 4,
                "children": [
                  {
                    "type": "core://Conditional",
                    "value": "$item.custom_server",
                    "content": {
                      "type": "core://TextField",
                      "field": "server",
                      "placeholder": "$item.server_placeholder",
                      "max_length": 200
                    }
                  },
                  {
                    "type": "core://Button",
                    "label": "Sign in to $item.title",
                    "on_click": {
                      "intent": "action.device",
                      "command": "sign_in",
                      "id": "$item.id",
                      "value": "$form?.server"
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "slot_id": "jacks",
        "provider_uri": "local://jacks",
        "content": {
          "type": "core://Column",
          "children": [
            {
              "type": "core://Use",
              "component": "core:section_header",
              "args": {
                "text": "Jacks",
                "divider": true
              }
            },
            {
              "type": "core://Tappable",
              "content_description": "Jacks: what this pod is plugged into",
              "on_click": {
                "intent": "action.navigation.open",
                "target_uri": "settings://jacks",
                "presentation": "Push"
              },
              "content": {
                "type": "core://Use",
                "component": "core:list_row",
                "args": {
                  "title": "Model, web, search and accounts",
                  "trailing": "›"
                }
              }
            }
          ]
        }
      },
      {
        "slot_id": "connected_apps",
        "provider_uri": "local://connected_apps",
        "content": {
          "type": "core://Column",
          "children": [
            {
              "type": "core://Use",
              "component": "core:section_header",
              "args": {
                "text": "Connected apps",
                "divider": true
              }
            },
            {
              "type": "core://Tappable",
              "content_description": "Connected apps: what can reach this pod through MCP",
              "on_click": {
                "intent": "action.navigation.open",
                "target_uri": "settings://connected_apps",
                "presentation": "Push"
              },
              "content": {
                "type": "core://Use",
                "component": "core:list_row",
                "args": {
                  "title": "Claude and other MCP apps",
                  "trailing": "›"
                }
              }
            }
          ]
        }
      },
      {
        "slot_id": "notifications",
        "provider_uri": "local://channels",
        "content": {
          "children": [
            {
              "type": "core://Use",
              "component": "core:section_header",
              "args": {
                "text": "Notifications",
                "divider": true
              }
            },
            {
              "empty_text": "Nothing sends notifications yet.",
              "group_by": {
                "field": "app_title",
                "header": {
                  "children": [
                    {
                      "content": {
                        "align": "Center",
                        "children": [
                          {
                            "style": "Body",
                            "type": "core://Text",
                            "value_expr": "$item.app_title"
                          },
                          {
                            "type": "core://Spacer"
                          },
                          {
                            "style": "Secondary",
                            "type": "core://Text",
                            "value_expr": "›"
                          }
                        ],
                        "padding_h_dp": 16,
                        "padding_v_dp": 14,
                        "spacing_dp": 8,
                        "type": "core://Row"
                      },
                      "content_description": "Notifications from $item.app_title",
                      "on_click": {
                        "intent": "action.navigation.open",
                        "presentation": "Push",
                        "target_uri": "settings://notifications/$item.layout"
                      },
                      "type": "core://Tappable"
                    },
                    {
                      "type": "core://Divider"
                    }
                  ],
                  "type": "core://Column"
                }
              },
              "item_template": {
                "content": {
                  "size_dp": 0,
                  "type": "core://Spacer"
                },
                "type": "core://Conditional",
                "value": "$item.never_shown"
              },
              "query_key": "local:channels",
              "type": "core://List"
            }
          ],
          "type": "core://Column"
        }
      },
      {
        "slot_id": "server",
        "provider_uri": "local://servers",
        "content": {
          "children": [
            {
              "type": "core://Divider"
            },
            {
              "children": [
                {
                  "label": "Leave pod on this device",
                  "on_click": {
                    "intent": "action.confirm",
                    "title": "Leave this pod?",
                    "message": "This device forgets the pod. Your data stays on the pod; you need its code to come back.",
                    "confirm_label": "Leave",
                    "then": {
                      "command": "leave_pod",
                      "intent": "action.device"
                    }
                  },
                  "type": "core://Button",
                  "style": "Secondary"
                }
              ],
              "padding_h_dp": 16,
              "padding_v_dp": 8,
              "type": "core://Column"
            }
          ],
          "type": "core://Column"
        }
      }
    ],
    "screens": [
      {
        "content": {
          "children": [
            {
              "empty_text": "No notifications from this app.",
              "group_by": {
                "field": "app_title",
                "header": {
                  "type": "core://Use",
                  "component": "core:section_header",
                  "args": {
                    "text": "$item.app_title",
                    "style": "Title",
                    "padding_v": 12
                  }
                }
              },
              "item_template": {
                "children": [
                  {
                    "children": [
                      {
                        "align": "Center",
                        "children": [
                          {
                            "style": "Body",
                            "type": "core://Text",
                            "value_expr": "$item.title"
                          },
                          {
                            "type": "core://Spacer"
                          },
                          {
                            "checked": "$item.enabled",
                            "content_description": "$item.title",
                            "on_click": {
                              "layout": "$item.layout",
                              "command": "toggle_channel",
                              "id": "$item.id",
                              "intent": "action.device"
                            },
                            "type": "core://Switch"
                          }
                        ],
                        "spacing_dp": 12,
                        "type": "core://Row"
                      },
                      {
                        "content": {
                          "style": "Secondary",
                          "type": "core://Text",
                          "value_expr": "$item.description"
                        },
                        "type": "core://Conditional",
                        "value": "$item.description"
                      }
                    ],
                    "padding_h_dp": 16,
                    "padding_v_dp": 10,
                    "spacing_dp": 2,
                    "type": "core://Column"
                  },
                  {
                    "type": "core://Divider"
                  }
                ],
                "type": "core://Column"
              },
              "query_key": "local:channels",
              "type": "core://List",
              "where": {
                "equals": "$route.layout",
                "field": "layout"
              }
            }
          ],
          "type": "core://Column"
        },
        "id": "notifications",
        "route": "settings://notifications/{layout}",
        "title": "Notifications"
      },
      {
        "id": "jacks",
        "route": "settings://jacks",
        "title": "Jacks",
        "data": "/v1/jacks/screen",
        "content": {
          "type": "core://Column",
          "children": [
            {
              "type": "core://Column",
              "padding_h_dp": 16,
              "spacing_dp": 8,
              "children": [
                {
                  "type": "core://Text",
                  "style": "Secondary",
                  "value_expr": "The abilities this pod is plugged into. Tap one to plug it in, give it a key, or unplug it."
                }
              ],
              "padding_v_dp": 8
            },
            {
              "type": "core://List",
              "query_key": "jacks",
              "empty_text": "Loading jacks…",
              "item_template": {
                "type": "core://Column",
                "children": [
                  {
                    "type": "core://Tappable",
                    "content_description": "$item.title: $item.state_label",
                    "on_click": {
                      "intent": "action.navigation.open",
                      "target_uri": "settings://jacks/$item.id",
                      "presentation": "Push"
                    },
                    "content": {
                      "type": "core://Column",
                      "padding_h_dp": 16,
                      "padding_v_dp": 10,
                      "spacing_dp": 2,
                      "children": [
                        {
                          "type": "core://Row",
                          "spacing_dp": 8,
                          "children": [
                            {
                              "type": "core://Text",
                              "style": "Body",
                              "value_expr": "$item.title"
                            },
                            {
                              "type": "core://Spacer"
                            },
                            {
                              "type": "core://Text",
                              "style": "Secondary",
                              "value_expr": "›"
                            }
                          ]
                        },
                        {
                          "type": "core://Text",
                          "style": "Secondary",
                          "value_expr": "$item.state_label"
                        }
                      ]
                    }
                  },
                  {
                    "type": "core://Divider"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "id": "jack",
        "route": "settings://jacks/{id}",
        "title": "${jacks://$route.id#title}",
        "data": "/v1/jacks/screen?id=$route.id",
        "content": {
          "type": "core://Column",
          "spacing_dp": 8,
          "padding_v_dp": 8,
          "children": [
            {
              "type": "core://Column",
              "padding_h_dp": 16,
              "spacing_dp": 8,
              "children": [
                {
                  "type": "core://Text",
                  "style": "Body",
                  "value_expr": "${jacks://$route.id#summary}"
                },
                {
                  "type": "core://Text",
                  "style": "Secondary",
                  "value_expr": "${jacks://$route.id#state_label}"
                }
              ]
            },
            {
              "type": "core://Conditional",
              "value": "${jacks://$route.id#is_account}",
              "content": {
                "type": "core://Column",
                "padding_h_dp": 16,
                "spacing_dp": 8,
                "children": [
                  {
                    "type": "core://Text",
                    "style": "Secondary",
                    "value_expr": "${jacks://$route.id#how}"
                  }
                ]
              }
            },
            {
              "type": "core://Conditional",
              "value": "${jacks://$route.id#is_switch}",
              "content": {
                "type": "core://Conditional",
                "value": "${jacks://$route.id#can_plug}",
                "content": {
                  "type": "core://Row",
                  "padding_h_dp": 16,
                  "children": [
                    {
                      "type": "core://Spacer"
                    },
                    {
                      "type": "core://Button",
                      "label": "Plug in",
                      "on_click": {
                        "intent": "action.sequence",
                        "steps": [
                          {
                            "intent": "action.mutation.optimistic",
                            "entity_uri": "jacks://$route.id",
                            "field": "state",
                            "value_expr": "\"plugged\"",
                            "endpoint": "/v1/jacks/plug",
                            "payload": {
                              "id": "$route.id"
                            },
                            "also": [
                              {
                                "field": "plugged",
                                "value_expr": "true"
                              },
                              {
                                "field": "can_plug",
                                "value_expr": "false"
                              },
                              {
                                "field": "can_unplug",
                                "value_expr": "true"
                              },
                              {
                                "field": "state_label",
                                "value_expr": "\"Plugged in\""
                              }
                            ]
                          },
                          {
                            "intent": "action.navigation.back"
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            },
            {
              "type": "core://Conditional",
              "value": "${jacks://$route.id#is_config}",
              "content": {
                "type": "core://Column",
                "padding_h_dp": 16,
                "spacing_dp": 16,
                "children": [
                  {
                    "type": "core://Conditional",
                    "value": "${jacks://$route.id#has_provider}",
                    "content": {
                      "type": "core://Column",
                      "spacing_dp": 4,
                      "children": [
                        {
                          "type": "core://Text",
                          "style": "Label",
                          "value_expr": "Provider"
                        },
                        {
                          "type": "core://ChoiceChips",
                          "field": "provider",
                          "options": [
                            {
                              "label": "Brave",
                              "value": "brave"
                            },
                            {
                              "label": "SearXNG",
                              "value": "searxng"
                            },
                            {
                              "label": "DuckDuckGo",
                              "value": "duckduckgo"
                            }
                          ]
                        },
                        {
                          "type": "core://Conditional",
                          "value": "${jacks://$route.id#provider}",
                          "content": {
                            "type": "core://Text",
                            "style": "Secondary",
                            "value_expr": "Now: ${jacks://$route.id#provider}"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "type": "core://Conditional",
                    "value": "${jacks://$route.id#has_api_key}",
                    "content": {
                      "type": "core://Column",
                      "spacing_dp": 4,
                      "children": [
                        {
                          "type": "core://Text",
                          "style": "Label",
                          "value_expr": "API key (Brave)"
                        },
                        {
                          "type": "core://Text",
                          "style": "Secondary",
                          "value_expr": "${jacks://$route.id#api_key_hint}"
                        },
                        {
                          "type": "core://TextField",
                          "field": "api_key",
                          "placeholder": "Paste the key",
                          "max_length": 2000,
                          "secret": true
                        }
                      ]
                    }
                  },
                  {
                    "type": "core://Conditional",
                    "value": "${jacks://$route.id#has_base_url}",
                    "content": {
                      "type": "core://Column",
                      "spacing_dp": 4,
                      "children": [
                        {
                          "type": "core://Text",
                          "style": "Label",
                          "value_expr": "Server address (SearXNG)"
                        },
                        {
                          "type": "core://Conditional",
                          "value": "${jacks://$route.id#base_url}",
                          "content": {
                            "type": "core://Text",
                            "style": "Secondary",
                            "value_expr": "Now: ${jacks://$route.id#base_url}"
                          }
                        },
                        {
                          "type": "core://TextField",
                          "field": "base_url",
                          "placeholder": "https://search.example",
                          "max_length": 500
                        }
                      ]
                    }
                  },
                  {
                    "type": "core://Text",
                    "style": "Secondary",
                    "value_expr": "The key goes straight to your pod, sealed, and is never shown again. Brave needs a key; SearXNG needs its address; DuckDuckGo needs neither."
                  },
                  {
                    "type": "core://Row",
                    "children": [
                      {
                        "type": "core://Spacer"
                      },
                      {
                        "type": "core://Button",
                        "label": "Save and plug in",
                        "on_click": {
                          "intent": "action.sequence",
                          "steps": [
                            {
                              "intent": "action.mutation.optimistic",
                              "entity_uri": "jacks://$route.id",
                              "field": "state",
                              "value_expr": "\"plugged\"",
                              "endpoint": "/v1/jacks/plug",
                              "payload": {
                                "id": "$route.id",
                                "config": {
                                  "provider": "$form?.provider",
                                  "api_key": "$form?.api_key",
                                  "base_url": "$form?.base_url"
                                }
                              },
                              "also": [
                                {
                                  "field": "plugged",
                                  "value_expr": "true"
                                },
                                {
                                  "field": "can_plug",
                                  "value_expr": "false"
                                },
                                {
                                  "field": "can_unplug",
                                  "value_expr": "true"
                                },
                                {
                                  "field": "state_label",
                                  "value_expr": "\"Plugged in\""
                                }
                              ]
                            },
                            {
                              "intent": "action.navigation.back"
                            }
                          ]
                        }
                      }
                    ]
                  }
                ],
                "padding_v_dp": 8
              }
            },
            {
              "type": "core://Conditional",
              "value": "${jacks://$route.id#can_unplug}",
              "content": {
                "type": "core://Row",
                "padding_h_dp": 16,
                "children": [
                  {
                    "type": "core://Spacer"
                  },
                  {
                    "type": "core://Button",
                    "label": "Unplug",
                    "on_click": {
                      "intent": "action.confirm",
                      "title": "Unplug ${jacks://$route.id#title}?",
                      "message": "What needs it stops working until you plug it in again. A key is forgotten.",
                      "confirm_label": "Unplug",
                      "then": {
                        "intent": "action.sequence",
                        "steps": [
                          {
                            "intent": "action.mutation.optimistic",
                            "entity_uri": "jacks://$route.id",
                            "field": "state",
                            "value_expr": "\"unplugged\"",
                            "endpoint": "/v1/jacks/unplug",
                            "payload": {
                              "id": "$route.id"
                            },
                            "also": [
                              {
                                "field": "plugged",
                                "value_expr": "false"
                              },
                              {
                                "field": "can_plug",
                                "value_expr": "true"
                              },
                              {
                                "field": "can_unplug",
                                "value_expr": "false"
                              },
                              {
                                "field": "state_label",
                                "value_expr": "\"Unplugged\""
                              }
                            ]
                          },
                          {
                            "intent": "action.navigation.back"
                          }
                        ]
                      }
                    },
                    "style": "Secondary"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "id": "connected_apps",
        "route": "settings://connected_apps",
        "title": "Connected apps",
        "data": "/v1/connected-apps/screen",
        "content": {
          "type": "core://Column",
          "children": [
            {
              "type": "core://Column",
              "padding_h_dp": 16,
              "padding_v_dp": 8,
              "spacing_dp": 8,
              "children": [
                {
                  "type": "core://Text",
                  "style": "Secondary",
                  "value_expr": "Apps you connected with your pod code, such as Claude. Each can read your pod's layouts and data and edit your own layouts. Disconnect any you don't recognise; changing the pod code doesn't disconnect them."
                }
              ]
            },
            {
              "type": "core://List",
              "query_key": "connected_apps",
              "empty_text": "No apps are connected.",
              "item_template": {
                "type": "core://Conditional",
                "value": "$item.connected",
                "content": {
                  "type": "core://Column",
                  "children": [
                    {
                      "type": "core://Row",
                      "spacing_dp": 8,
                      "padding_h_dp": 16,
                      "padding_v_dp": 10,
                      "align": "Center",
                      "children": [
                        {
                          "type": "core://Container",
                          "orientation": "Vertical",
                          "padding_dp": 0,
                          "children": [
                            {
                              "type": "core://Text",
                              "style": "Body",
                              "value_expr": "$item.title"
                            },
                            {
                              "type": "core://Text",
                              "style": "Secondary",
                              "value_expr": "$item.detail"
                            },
                            {
                              "type": "core://Text",
                              "style": "Secondary",
                              "value_expr": "$item.expiry"
                            }
                          ]
                        },
                        {
                          "type": "core://Spacer"
                        },
                        {
                          "type": "core://Button",
                          "style": "Secondary",
                          "label": "Disconnect",
                          "on_click": {
                            "intent": "action.confirm",
                            "title": "Disconnect this app?",
                            "message": "It stops reaching your pod at once. To use it again, connect it again with your pod code.",
                            "confirm_label": "Disconnect",
                            "then": {
                              "intent": "action.mutation.optimistic",
                              "entity_uri": "connected_apps://$item.id",
                              "field": "connected",
                              "value_expr": "false",
                              "endpoint": "/v1/connected-apps/revoke",
                              "payload": {
                                "id": "$item.id"
                              }
                            }
                          }
                        }
                      ]
                    },
                    {
                      "type": "core://Divider"
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    ]
  }
}
