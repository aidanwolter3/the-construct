{
  "note": "Apps, Notifications and Settings are dock tabs drawn from layout; at most two apps in the dock",
  "layout": {
    "type": "core://Workspace",
    "id": "shell",
    "title": "Home",
    "slots": [
      {
        "slot_id": "dock",
        "provider_uri": "local://apps",
        "content": {
          "type": "core://Dock",
          "field": "tab",
          "query_key": "local:apps",
          "max_items": 2,
          "item": {
            "value": "$item.id",
            "label": "$item.title",
            "icon": "$item.icon",
            "badge": "$item.unread",
            "content": {
              "type": "core://AppFrame",
              "app": "$item.id"
            }
          },
          "after": [
            {
              "value": "apps",
              "label": "Apps",
              "icon": "apps",
              "content": {
                "type": "core://Column",
                "children": [
                  {
                    "type": "core://Column",
                    "children": [
                      {
                        "type": "core://Text",
                        "value_expr": "Apps",
                        "style": "Headline"
                      }
                    ],
                    "padding_h_dp": 16,
                    "padding_v_dp": 16
                  },
                  {
                    "type": "core://Conditional",
                    "value": "${local://apps#count}",
                    "content": {
                      "type": "core://Column",
                      "children": [
                        {
                          "type": "core://Text",
                          "value_expr": "No apps yet",
                          "style": "Title"
                        },
                        {
                          "type": "core://Text",
                          "value_expr": "Ask your agent to build one. For example:",
                          "style": "Secondary"
                        },
                        {
                          "type": "core://Box",
                          "background": "#F2F4F7",
                          "corner_dp": 12,
                          "padding_h_dp": 14,
                          "padding_v_dp": 10,
                          "content": {
                            "type": "core://Text",
                            "value_expr": "“Show me my Pixelfed feed”",
                            "style": "Body"
                          }
                        },
                        {
                          "type": "core://Box",
                          "background": "#F2F4F7",
                          "corner_dp": 12,
                          "padding_h_dp": 14,
                          "padding_v_dp": 10,
                          "content": {
                            "type": "core://Text",
                            "value_expr": "“A log of car and home maintenance”",
                            "style": "Body"
                          }
                        },
                        {
                          "type": "core://Box",
                          "background": "#F2F4F7",
                          "corner_dp": 12,
                          "padding_h_dp": 14,
                          "padding_v_dp": 10,
                          "content": {
                            "type": "core://Text",
                            "value_expr": "“Concerts at venues I like”",
                            "style": "Body"
                          }
                        },
                        {
                          "type": "core://Text",
                          "value_expr": "Your agent connects to this pod with your pod code.",
                          "style": "Caption"
                        }
                      ],
                      "padding_h_dp": 16,
                      "padding_v_dp": 8,
                      "spacing_dp": 10
                    },
                    "equals": "0"
                  },
                  {
                    "type": "core://List",
                    "query_key": "local:apps",
                    "item_template": {
                      "type": "core://Tappable",
                      "on_click": {
                        "intent": "action.device",
                        "command": "open_app",
                        "app": "$item.id"
                      },
                      "content": {
                        "type": "core://Row",
                        "children": [
                          {
                            "type": "core://Text",
                            "value_expr": "$item.title",
                            "style": "Body"
                          },
                          {
                            "type": "core://Spacer"
                          },
                          {
                            "type": "core://Text",
                            "value_expr": "$item.detail",
                            "style": "Caption"
                          }
                        ],
                        "padding_h_dp": 16,
                        "padding_v_dp": 12,
                        "spacing_dp": 8
                      },
                      "tag": "apps-$item.id"
                    },
                    "empty_text": ""
                  }
                ]
              }
            },
            {
              "value": "notifications",
              "label": "Notifications",
              "icon": "notifications",
              "badge": "${local://inbox#unread}",
              "content": {
                "type": "core://Column",
                "children": [
                  {
                    "type": "core://Row",
                    "children": [
                      {
                        "type": "core://Text",
                        "value_expr": "Notifications",
                        "style": "Headline"
                      },
                      {
                        "type": "core://Spacer"
                      },
                      {
                        "type": "core://Button",
                        "label": "Mark all read",
                        "on_click": {
                          "intent": "action.device",
                          "command": "mark_all_read"
                        }
                      }
                    ],
                    "padding_h_dp": 16,
                    "padding_v_dp": 12,
                    "spacing_dp": 8
                  },
                  {
                    "type": "core://List",
                    "query_key": "local:notifications",
                    "item_template": {
                      "type": "core://Tappable",
                      "on_click": {
                        "intent": "action.device",
                        "command": "open_notification",
                        "id": "$item.id"
                      },
                      "content": {
                        "type": "core://Column",
                        "children": [
                          {
                            "type": "core://Row",
                            "children": [
                              {
                                "type": "core://Text",
                                "value_expr": "$item.title",
                                "style": "Body"
                              },
                              {
                                "type": "core://Spacer"
                              },
                              {
                                "type": "core://Conditional",
                                "value": "$item.unread",
                                "content": {
                                  "type": "core://Chip",
                                  "text": "New"
                                }
                              },
                              {
                                "type": "core://Text",
                                "value_expr": "$item.when",
                                "style": "Caption"
                              }
                            ],
                            "padding_h_dp": 0,
                            "padding_v_dp": 0,
                            "spacing_dp": 8
                          },
                          {
                            "type": "core://Conditional",
                            "value": "$item.body",
                            "content": {
                              "type": "core://Text",
                              "value_expr": "$item.body",
                              "style": "Secondary"
                            }
                          },
                          {
                            "type": "core://Text",
                            "value_expr": "$item.app_title",
                            "style": "Caption"
                          }
                        ],
                        "padding_h_dp": 16,
                        "padding_v_dp": 10,
                        "spacing_dp": 2
                      },
                      "tag": "notification-$item.id"
                    },
                    "empty_text": "No notifications yet",
                    "group_by": {
                      "field": "day",
                      "header": {
                        "type": "core://Column",
                        "children": [
                          {
                            "type": "core://Text",
                            "value_expr": "$item.day",
                            "style": "Label"
                          }
                        ],
                        "padding_h_dp": 16,
                        "padding_v_dp": 8
                      }
                    }
                  }
                ]
              }
            },
            {
              "value": "settings",
              "label": "Settings",
              "icon": "settings",
              "badge": "${local://connection#attention}",
              "content": {
                "type": "core://Column",
                "children": [
                  {
                    "type": "core://Column",
                    "children": [
                      {
                        "type": "core://Text",
                        "value_expr": "Settings",
                        "style": "Headline"
                      }
                    ],
                    "padding_h_dp": 16,
                    "padding_v_dp": 16
                  },
                  {
                    "type": "core://Column",
                    "children": [
                      {
                        "type": "core://Text",
                        "value_expr": "Your pod",
                        "style": "Label"
                      }
                    ],
                    "padding_h_dp": 16,
                    "padding_v_dp": 8
                  },
                  {
                    "type": "core://Row",
                    "children": [
                      {
                        "type": "core://Text",
                        "value_expr": "${local://connection#label}",
                        "style": "Body"
                      },
                      {
                        "type": "core://Spacer"
                      },
                      {
                        "type": "core://Text",
                        "value_expr": "${local://session#server}",
                        "style": "Caption"
                      }
                    ],
                    "padding_h_dp": 16,
                    "padding_v_dp": 4,
                    "spacing_dp": 8
                  },
                  {
                    "type": "core://List",
                    "query_key": "local:servers",
                    "item_template": {
                      "type": "core://Tappable",
                      "on_click": {
                        "intent": "action.device",
                        "command": "set_server",
                        "id": "$item.id"
                      },
                      "content": {
                        "type": "core://Column",
                        "children": [
                          {
                            "type": "core://Row",
                            "children": [
                              {
                                "type": "core://Text",
                                "value_expr": "$item.title",
                                "style": "Body"
                              },
                              {
                                "type": "core://Spacer"
                              },
                              {
                                "type": "core://Conditional",
                                "value": "$item.selected",
                                "content": {
                                  "type": "core://Text",
                                  "value_expr": "Current",
                                  "style": "Caption"
                                }
                              }
                            ],
                            "spacing_dp": 8
                          },
                          {
                            "type": "core://Text",
                            "value_expr": "$item.url",
                            "style": "Caption"
                          }
                        ],
                        "padding_h_dp": 16,
                        "padding_v_dp": 8,
                        "spacing_dp": 2
                      },
                      "tag": "server-$item.id"
                    },
                    "empty_text": ""
                  },
                  {
                    "type": "core://Row",
                    "children": [
                      {
                        "type": "core://Button",
                        "label": "Leave pod",
                        "on_click": {
                          "intent": "action.device",
                          "command": "leave_pod"
                        }
                      }
                    ],
                    "padding_h_dp": 16,
                    "padding_v_dp": 8,
                    "spacing_dp": 8
                  },
                  {
                    "type": "core://Divider"
                  },
                  {
                    "type": "core://Column",
                    "children": [
                      {
                        "type": "core://Text",
                        "value_expr": "Sign-ins",
                        "style": "Label"
                      }
                    ],
                    "padding_h_dp": 16,
                    "padding_v_dp": 8
                  },
                  {
                    "type": "core://List",
                    "query_key": "local:sign_ins",
                    "item_template": {
                      "type": "core://Column",
                      "children": [
                        {
                          "type": "core://Row",
                          "children": [
                            {
                              "type": "core://Text",
                              "value_expr": "$item.title",
                              "style": "Body"
                            },
                            {
                              "type": "core://Spacer"
                            },
                            {
                              "type": "core://Button",
                              "label": "Sign out",
                              "on_click": {
                                "intent": "action.device",
                                "command": "sign_out"
                              }
                            }
                          ],
                          "spacing_dp": 8
                        },
                        {
                          "type": "core://Text",
                          "value_expr": "$item.detail",
                          "style": "Caption"
                        }
                      ],
                      "padding_h_dp": 16,
                      "padding_v_dp": 8,
                      "spacing_dp": 2
                    },
                    "empty_text": "Not signed in to anything yet."
                  },
                  {
                    "type": "core://List",
                    "query_key": "local:providers",
                    "item_template": {
                      "type": "core://Row",
                      "children": [
                        {
                          "type": "core://Text",
                          "value_expr": "$item.title",
                          "style": "Body"
                        },
                        {
                          "type": "core://Spacer"
                        },
                        {
                          "type": "core://Button",
                          "label": "Sign in",
                          "on_click": {
                            "intent": "action.device",
                            "command": "sign_in",
                            "id": "$item.id"
                          }
                        }
                      ],
                      "padding_h_dp": 16,
                      "padding_v_dp": 12,
                      "spacing_dp": 8
                    },
                    "empty_text": ""
                  },
                  {
                    "type": "core://Divider"
                  },
                  {
                    "type": "core://Column",
                    "children": [
                      {
                        "type": "core://Text",
                        "value_expr": "Notifications",
                        "style": "Label"
                      }
                    ],
                    "padding_h_dp": 16,
                    "padding_v_dp": 8
                  },
                  {
                    "type": "core://List",
                    "query_key": "local:channels",
                    "item_template": {
                      "type": "core://Column",
                      "children": [
                        {
                          "type": "core://Row",
                          "children": [
                            {
                              "type": "core://Text",
                              "value_expr": "$item.title",
                              "style": "Body"
                            },
                            {
                              "type": "core://Spacer"
                            },
                            {
                              "type": "core://Switch",
                              "checked": "$item.enabled",
                              "on_click": {
                                "intent": "action.device",
                                "command": "toggle_channel",
                                "app": "$item.app_id",
                                "id": "$item.id"
                              },
                              "content_description": "$item.title"
                            }
                          ],
                          "spacing_dp": 8
                        },
                        {
                          "type": "core://Text",
                          "value_expr": "$item.app_title",
                          "style": "Caption"
                        }
                      ],
                      "padding_h_dp": 16,
                      "padding_v_dp": 8,
                      "spacing_dp": 2
                    },
                    "empty_text": "No app sends notifications yet."
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
