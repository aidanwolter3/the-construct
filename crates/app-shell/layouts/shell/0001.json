{
  "note": "The home blueprint: a dock of the pod's apps, and a More tab with every app, the inbox and Settings",
  "layout": {
    "type": "core://Workspace",
    "id": "shell",
    "title": "Home",
    "slots": [
      {
        "slot_id": "dock",
        "provider_uri": "local://apps",
        "content": {
          "type": "core://Dock",
          "field": "tab",
          "query_key": "local:apps",
          "max_items": 4,
          "item": {
            "value": "$item.id",
            "label": "$item.title",
            "icon": "$item.icon",
            "badge": "$item.unread",
            "content": {
              "type": "core://AppFrame",
              "app": "$item.id"
            }
          },
          "after": [
            {
              "value": "more",
              "label": "More",
              "icon": "more",
              "badge": "${local://connection#attention}",
              "content": {
                "type": "core://Column",
                "children": [
                  {
                    "type": "core://Column",
                    "padding_h_dp": 16,
                    "padding_v_dp": 16,
                    "children": [
                      {
                        "type": "core://Text",
                        "value_expr": "Your construct",
                        "style": "Headline"
                      }
                    ]
                  },
                  {
                    "type": "core://Conditional",
                    "value": "${local://apps#count}",
                    "equals": "0",
                    "content": {
                      "type": "core://Column",
                      "spacing_dp": 10,
                      "padding_h_dp": 16,
                      "padding_v_dp": 8,
                      "children": [
                        {
                          "type": "core://Text",
                          "value_expr": "No apps yet",
                          "style": "Title"
                        },
                        {
                          "type": "core://Text",
                          "value_expr": "Ask your agent to build one. For example:",
                          "style": "Secondary"
                        },
                        {
                          "type": "core://Box",
                          "background": "#F2F4F7",
                          "corner_dp": 12,
                          "padding_h_dp": 14,
                          "padding_v_dp": 10,
                          "content": {
                            "type": "core://Text",
                            "value_expr": "“Show me my Pixelfed feed”",
                            "style": "Body"
                          }
                        },
                        {
                          "type": "core://Box",
                          "background": "#F2F4F7",
                          "corner_dp": 12,
                          "padding_h_dp": 14,
                          "padding_v_dp": 10,
                          "content": {
                            "type": "core://Text",
                            "value_expr": "“A log of car and home maintenance”",
                            "style": "Body"
                          }
                        },
                        {
                          "type": "core://Box",
                          "background": "#F2F4F7",
                          "corner_dp": 12,
                          "padding_h_dp": 14,
                          "padding_v_dp": 10,
                          "content": {
                            "type": "core://Text",
                            "value_expr": "“Concerts at venues I like”",
                            "style": "Body"
                          }
                        },
                        {
                          "type": "core://Text",
                          "value_expr": "Your agent connects to this pod with your pod code.",
                          "style": "Caption"
                        }
                      ]
                    }
                  },
                  {
                    "type": "core://Conditional",
                    "value": "${local://apps#count}",
                    "content": {
                      "type": "core://Column",
                      "children": [
                        {
                          "type": "core://Column",
                          "padding_h_dp": 16,
                          "padding_v_dp": 8,
                          "children": [
                            {
                              "type": "core://Text",
                              "value_expr": "Apps",
                              "style": "Label"
                            }
                          ]
                        },
                        {
                          "type": "core://List",
                          "query_key": "local:apps",
                          "empty_text": "No apps yet.",
                          "item_template": {
                            "type": "core://Tappable",
                            "on_click": {
                              "intent": "action.device",
                              "command": "open_app",
                              "app": "$item.id"
                            },
                            "content": {
                              "type": "core://Row",
                              "children": [
                                {
                                  "type": "core://Text",
                                  "value_expr": "$item.title",
                                  "style": "Body"
                                },
                                {
                                  "type": "core://Spacer"
                                },
                                {
                                  "type": "core://Text",
                                  "value_expr": "$item.detail",
                                  "style": "Caption"
                                }
                              ],
                              "padding_h_dp": 16,
                              "padding_v_dp": 12,
                              "spacing_dp": 8
                            },
                            "tag": "more-app-$item.id"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "type": "core://Divider"
                  },
                  {
                    "type": "core://Tappable",
                    "on_click": {
                      "intent": "action.device",
                      "command": "open_inbox"
                    },
                    "content": {
                      "type": "core://Row",
                      "children": [
                        {
                          "type": "core://Text",
                          "value_expr": "Inbox",
                          "style": "Body"
                        },
                        {
                          "type": "core://Spacer"
                        },
                        {
                          "type": "core://Text",
                          "value_expr": "${local://inbox#label}",
                          "style": "Caption"
                        }
                      ],
                      "padding_h_dp": 16,
                      "padding_v_dp": 12,
                      "spacing_dp": 8
                    },
                    "tag": "more-inbox"
                  },
                  {
                    "type": "core://Tappable",
                    "on_click": {
                      "intent": "action.device",
                      "command": "open_settings"
                    },
                    "content": {
                      "type": "core://Row",
                      "children": [
                        {
                          "type": "core://Text",
                          "value_expr": "Settings",
                          "style": "Body"
                        },
                        {
                          "type": "core://Spacer"
                        },
                        {
                          "type": "core://Text",
                          "value_expr": "${local://connection#label}",
                          "style": "Caption"
                        }
                      ],
                      "padding_h_dp": 16,
                      "padding_v_dp": 12,
                      "spacing_dp": 8
                    },
                    "tag": "more-settings"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
