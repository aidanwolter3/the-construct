{
  "note": "The blank page, with Notifications and Settings at the top right (they are layouts now)",
  "layout": {
    "type": "core://Workspace",
    "id": "shell",
    "title": "The Construct",
    "slots": [
      {
        "slot_id": "home",
        "provider_uri": "local://home",
        "content": {
          "type": "core://Box",
          "fill": true,
          "background": "#F7F5F0",
          "align": "Center",
          "padding_h_dp": 24,
          "content": {
            "type": "core://Column",
            "align": "Center",
            "spacing_dp": 8,
            "children": [
              {
                "type": "core://Text",
                "style": "Display",
                "value_expr": "The Construct"
              },
              {
                "type": "core://Text",
                "style": "Secondary",
                "value_expr": "Ask your agent to build anything"
              },
              {
                "type": "core://Row",
                "align": "Center",
                "spacing_dp": 8,
                "children": [
                  {
                    "type": "core://IconButton",
                    "icon": "notifications",
                    "content_description": "Notifications",
                    "on_click": {"intent": "action.navigation.open", "layout": "inbox", "presentation": "Sheet"}
                  },
                  {
                    "type": "core://IconButton",
                    "icon": "settings",
                    "content_description": "Settings",
                    "on_click": {"intent": "action.navigation.open", "layout": "settings", "presentation": "Panel"}
                  }
                ]
              }
            ]
          }
        }
      }
    ]
  }
}
