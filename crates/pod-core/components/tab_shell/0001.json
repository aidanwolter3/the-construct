        }
       ]
      }
     }
    ]
   }
  },
  "examples": [
   {
    "args": {
     "first": "home",
     "tabs": [
      {
       "key": "home",
       "title": "Home",
       "icon": "check_box"
      },
      {
       "key": "lists",
       "title": "Lists",
       "icon": "bookmark"
      },
      {
       "key": "more",
       "title": "More",
       "icon": "settings"
      }
     ]
    },
    "slots": {
     "home": [
      {
       "type": "core://Text",
       "style": "Title",
       "value_expr": "Today"
      }
     ],
     "lists": [
      {
       "type": "core://Text",
       "style": "Title",
       "value_expr": "Lists"
      }
     ],
     "more": [
      {
       "type": "core://Text",
       "style": "Title",
       "value_expr": "More"
      }
     ]
    },
