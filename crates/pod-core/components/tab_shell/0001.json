                      "weight": "SemiBold",
                      "value_expr": "$arg.tab_title"
                     },
                     {
                      "type": "core://Spacer"
                     }
                    ]
                   }
                  }
                 },
                 {
                  "type": "core://IfArg",
                  "arg": "tab_key",
                  "equals": "$arg.first",
                  "then": {
                   "type": "core://Conditional",
                   "value": "${$arg.state#tab}",
                   "not": true,
                   "content": {
                    "type": "core://Box",
                    "corner_dp": 12,
                    "background": "${local://theme#accent_surface}",
                    "content_color": "${local://theme#accent}",
                    "padding_h_dp": 12,
                    "padding_v_dp": 10,
                    "content": {
                     "type": "core://Row",
                     "align": "Center",
                     "spacing_dp": 12,
                     "children": [
                      {
                       "type": "core://Badge",
                       "text": "",
                       "icon": "$arg.tab_icon"
                      },
                      {
                       "type": "core://Text",
                       "style": "Label",
                       "weight": "SemiBold",
                       "value_expr": "$arg.tab_title"
                      },
                      {
                       "type": "core://Spacer"
                      }
                     ]
                    }
                   }
                  }
                 }
                ]
               },
               {
                "type": "core://IfArg",
                "arg": "tab_key",
                "equals": "$arg.first",
                "then": {
                 "type": "core://Conditional",
                 "value": "${$arg.state#tab}",
                 "content": {
                  "type": "core://Conditional",
                  "value": "${$arg.state#tab}",
                  "equals": "$arg.tab_key",
                  "content": {
                   "type": "core://Box",
                   "corner_dp": 12,
                   "content_color": "${local://theme#muted_text}",
                   "padding_h_dp": 12,
                   "padding_v_dp": 10,
                   "content": {
                    "type": "core://Row",
                    "align": "Center",
                    "spacing_dp": 12,
                    "children": [
                     {
                      "type": "core://Badge",
                      "text": "",
                      "icon": "$arg.tab_icon"
                     },
                     {
                      "type": "core://Text",
                      "style": "Label",
                      "weight": "Medium",
                      "value_expr": "$arg.tab_title"
                     },
                     {
                      "type": "core://Spacer"
                     }
                    ]
                   }
                  },
                  "not": true
                 }
                },
                "else": {
                 "type": "core://Conditional",
                 "value": "${$arg.state#tab}",
                 "equals": "$arg.tab_key",
                 "content": {
                  "type": "core://Box",
                  "corner_dp": 12,
                  "content_color": "${local://theme#muted_text}",
                  "padding_h_dp": 12,
                  "padding_v_dp": 10,
                  "content": {
                   "type": "core://Row",
                   "align": "Center",
                   "spacing_dp": 12,
                   "children": [
                    {
                     "type": "core://Badge",
                     "text": "",
                     "icon": "$arg.tab_icon"
                    },
                    {
                     "type": "core://Text",
                     "style": "Label",
                     "weight": "Medium",
                     "value_expr": "$arg.tab_title"
                    },
                    {
                     "type": "core://Spacer"
                    }
                   ]
                  }
                 },
                 "not": true
                }
               }
              ]
             }
            }
           },
           {
            "type": "core://Children",
            "slot": "rail_bottom"
           }
          ]
         }
        },
        {
         "type": "core://Box",
         "fill": true,
         "content": {
          "type": "core://Column",
          "children": [
           {
            "type": "core://Each",
            "arg": "tabs",
            "as": "tab",
            "template": {
             "type": "core://Fragment",
             "children": [
              {
               "type": "core://Conditional",
               "value": "${$arg.state#tab}",
               "equals": "$arg.tab_key",
               "content": {
                "type": "core://Children",
                "slot": "$arg.tab_key"
               }
              },
              {
               "type": "core://IfArg",
               "arg": "tab_key",
               "equals": "$arg.first",
               "then": {
                "type": "core://Conditional",
                "value": "${$arg.state#tab}",
                "not": true,
