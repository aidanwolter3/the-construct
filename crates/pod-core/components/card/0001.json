{
  "note": "First version",
  "component": {
    "doc": "A bordered, rounded card holding its children in a column (events, sites, alerts). Wrap it in core://Tappable to open something.",
    "params": [
      {
        "name": "spacing",
        "type": "number",
        "doc": "Space between the children.",
        "default": 0
      },
      {
        "name": "border",
        "type": "text",
        "doc": "Border colour (#RRGGBB or a binding such as ${local://theme#card_border}).",
        "default": "#E4E4EA"
      }
    ],
    "children": true,
    "template": {
      "type": "core://Box",
      "border_color": "$arg.border",
      "corner_dp": 14,
      "padding_h_dp": 14,
      "padding_v_dp": 12,
      "content": {
        "type": "core://Column",
        "spacing_dp": "$arg.spacing",
        "children": [
          {
            "type": "core://Children"
          }
        ]
      }
    },
    "examples": [
      {
        "args": {
          "spacing": 6
        },
        "children": [
          {
            "type": "core://Text",
            "value_expr": "$item.title",
            "style": "Label"
          },
          {
            "type": "core://Text",
            "value_expr": "$item.venue",
            "style": "Secondary"
          }
        ],
        "note": "an event"
      }
    ]
  }
}
