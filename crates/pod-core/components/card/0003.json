{
  "note": "A corner parameter (default 14, as before), so cards with tighter corners are cards too",
  "component": {
    "doc": "A bordered, rounded card holding its children in a column (events, sites, alerts). Wrap it in core://Tappable to open something.",
    "params": [
      {
        "name": "spacing",
        "type": "number",
        "doc": "Space between the children.",
        "default": 0
      },
      {
        "name": "border",
        "type": "text",
        "doc": "Border colour (#RRGGBB or a binding such as ${local://theme#card_border}).",
        "default": "${local://theme#card_border}"
      },
      {
        "name": "background",
        "type": "text",
        "doc": "Fill colour (#RRGGBB or a binding such as ${local://theme#card}).",
        "default": "${local://theme#card}"
      },
      {
        "name": "corner",
        "type": "number",
        "doc": "Corner radius.",
        "default": 14
      }
    ],
    "children": true,
    "template": {
      "type": "core://Box",
      "background": "$arg.background",
      "border_color": "$arg.border",
      "corner_dp": "$arg.corner",
      "padding_h_dp": 14,
      "padding_v_dp": 12,
      "content": {
        "type": "core://Column",
        "spacing_dp": "$arg.spacing",
        "children": [
          {
            "type": "core://Children"
          }
        ]
      }
    },
    "examples": [
      {
        "args": {
          "spacing": 6
        },
        "children": [
          {
            "type": "core://Text",
            "value_expr": "$item.title",
            "style": "Label"
          },
          {
            "type": "core://Text",
            "value_expr": "$item.venue",
            "style": "Secondary"
          }
        ],
        "note": "an event"
      },
      {
        "args": {
          "spacing": 4,
          "corner": 12
        },
        "children": [
          {
            "type": "core://Text",
            "value_expr": "$item.store",
            "style": "Label"
          },
          {
            "type": "core://Text",
            "value_expr": "$item.why",
            "style": "Secondary"
          }
        ],
        "note": "an option to pick, with tighter corners"
      },
      {
        "args": {
          "spacing": 6,
          "corner": 12
        },
        "children": [
          {
            "type": "core://Text",
            "value_expr": "$item.title",
            "style": "Label"
          },
          {
            "type": "core://Text",
            "value_expr": "$item.body",
            "style": "Secondary"
          }
        ],
        "note": "a notification"
      }
    ]
  }
}
