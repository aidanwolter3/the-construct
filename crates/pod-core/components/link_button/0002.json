{
  "note": "A style and a size, as core:button (decision one-button-node)",
  "component": {
    "doc": "A button that opens a web link, shown only while the link is set.",
    "params": [
      {
        "name": "label",
        "type": "text",
        "doc": "The button's text.",
        "required": true
      },
      {
        "name": "url",
        "type": "binding",
        "doc": "The link (a binding such as $item.url).",
        "required": true
      },
      {
        "name": "style",
        "type": "text",
        "doc": "Primary, Secondary, Tonal or Text (see core:button).",
        "default": "Primary"
      },
      {
        "name": "size",
        "type": "text",
        "doc": "Regular (40 dp) or Small (32 dp).",
        "default": "Regular"
      }
    ],
    "template": {
      "type": "core://Conditional",
      "value": "$arg.url",
      "content": {
        "type": "core://Button",
        "label": "$arg.label",
        "on_click": {
          "intent": "action.link.open",
          "url": "$arg.url"
        },
        "style": "$arg.style",
        "size": "$arg.size"
      }
    },
    "examples": [
      {
        "args": {
          "label": "Get tickets",
          "url": "$item.tickets_url"
        },
        "note": "tickets when the event has them"
      },
      {
        "args": {
          "label": "Website",
          "url": "$item.url",
          "style": "Secondary"
        },
        "note": "beside a main button"
      }
    ]
  }
}
