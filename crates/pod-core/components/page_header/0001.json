{
  "note": "First version: the header row pages with their own chrome repeat (Back, the title, actions on the right)",
  "component": {
    "doc": "A page's header on one line: Back (while the page can go back), the title, and actions (icon buttons) on the right. The top of a layout whose root is a core://Page, which gets no chrome from the app.",
    "params": [
      {
        "name": "title",
        "type": "text",
        "doc": "The title (bindings allowed).",
        "required": true
      },
      {
        "name": "style",
        "type": "text",
        "doc": "A core://Text style.",
        "default": "Title"
      },
      {
        "name": "padding_h",
        "type": "number",
        "doc": "Side padding.",
        "default": 12
      },
      {
        "name": "padding_v",
        "type": "number",
        "doc": "Top and bottom padding.",
        "default": 4
      }
    ],
    "children": true,
    "template": {
      "type": "core://Row",
      "align": "Center",
      "spacing_dp": 4,
      "padding_h_dp": "$arg.padding_h",
      "padding_v_dp": "$arg.padding_v",
      "children": [
        {
          "type": "core://Use",
          "component": "core:back_button"
        },
        {
          "type": "core://Text",
          "value_expr": "$arg.title",
          "style": "$arg.style"
        },
        {
          "type": "core://Spacer"
        },
        {
          "type": "core://Children"
        }
      ]
    },
    "examples": [
      {
        "args": {
          "title": "Reading list"
        },
        "note": "a pushed list page: Back and the title, no actions"
      },
      {
        "args": {
          "title": "Packing"
        },
        "children": [
          {
            "type": "core://IconButton",
            "icon": "add",
            "content_description": "Add an item",
            "on_click": {
              "intent": "action.navigation.open",
              "layout": "c-example",
              "presentation": "Sheet"
            }
          }
        ],
        "note": "a checklist page with an add button on the right"
      },
      {
        "args": {
          "title": "${collections://trips/$route.id#name}",
          "style": "Headline"
        },
        "note": "an item's page titled from its data, in the headline style"
      }
    ]
  }
}
