{
  "note": "A piece of the taste feed as a sheet: its photo, brand, title and price, Buy, like or dislike, and the pieces like it (each opens its own sheet). Opened by the taste layout with params {key}, then the item's data path loaded.",
  "layout": {
    "type": "core://Page",
    "id": "taste_item",
    "title": "Piece",
    "root": {
      "type": "core://Use",
      "component": "core:screen_scaffold",
      "args": {
        "title": "Piece",
        "spacing": 14
      },
      "children": [
        {
          "type": "core://List",
          "query_key": "taste:item:$route.key",
          "spacing_dp": 14,
          "empty_text": "Loading…",
          "item_template": {
            "type": "core://Column",
            "spacing_dp": 14,
            "children": [
              {
                "type": "core://Row",
                "spacing_dp": 12,
                "align": "Center",
                "children": [
                  {
                    "type": "core://Image",
                    "url": "$item.thumb",
                    "size_dp": 88,
                    "shape": "Rounded",
                    "content_description": "$item.title"
                  },
                  {
                    "type": "core://Column",
                    "spacing_dp": 2,
                    "children": [
                      {
                        "type": "core://Text",
                        "value_expr": "$item.brand",
                        "style": "Caption",
                        "caps": true,
                        "weight": "SemiBold",
                        "max_lines": 1
                      },
                      {
                        "type": "core://Text",
                        "value_expr": "$item.title",
                        "style": "Title",
                        "max_lines": 2
                      },
                      {
                        "type": "core://Text",
                        "value_expr": "$item.price_text",
                        "style": "Body"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "core://Row",
                "children": [
                  {
                    "type": "core://Use",
                    "component": "core:link_button",
                    "args": {
                      "label": "Buy at $item.host",
                      "url": "$item.buy_url"
                    }
                  },
                  {
                    "type": "core://Spacer"
                  },
                  {
                    "type": "core://Conditional",
                    "value": "$item.liked",
                    "content": {
                      "type": "core://Button",
                      "label": "Liked",
                      "on_click": {
                        "intent": "action.mutation.optimistic",
                        "entity_uri": "$item.uri",
                        "field": "liked",
                        "value_expr": "false",
                        "rollback_value": false,
                        "endpoint": "/v1/taste/react",
                        "payload": {
                          "id": "$item.id",
                          "liked": "$value"
                        },
                        "also": [
                          {
                            "field": "skipped",
                            "value_expr": "false"
                          }
                        ]
                      },
                      "style": "Primary",
                      "size": "Small"
                    },
                    "equals": "true"
                  },
                  {
                    "type": "core://Conditional",
                    "value": "$item.liked",
                    "content": {
                      "type": "core://Button",
                      "label": "Like",
                      "on_click": {
                        "intent": "action.mutation.optimistic",
                        "entity_uri": "$item.uri",
                        "field": "liked",
                        "value_expr": "true",
                        "rollback_value": false,
                        "endpoint": "/v1/taste/react",
                        "payload": {
                          "id": "$item.id",
                          "liked": "$value"
                        },
                        "also": [
                          {
                            "field": "skipped",
                            "value_expr": "false"
                          }
                        ]
                      },
                      "style": "Secondary",
                      "size": "Small"
                    },
                    "equals": "true",
                    "not": true
                  },
                  {
                    "type": "core://Button",
                    "label": "Dislike",
                    "on_click": {
                      "intent": "action.mutation.optimistic",
                      "entity_uri": "$item.uri",
                      "field": "skipped",
                      "value_expr": "true",
                      "rollback_value": false,
                      "endpoint": "/v1/taste/react",
                      "payload": {
                        "id": "$item.id",
                        "skipped": "$value"
                      },
                      "also": [
                        {
                          "field": "liked",
                          "value_expr": "false"
                        }
                      ]
                    },
                    "style": "Text",
                    "size": "Small"
                  }
                ],
                "spacing_dp": 6
              }
            ]
          }
        },
        {
          "type": "core://Use",
          "component": "core:titled_section",
          "args": {
            "text": "Similar"
          },
          "children": [
            {
              "type": "core://List",
              "query_key": "taste:similar:$route.key",
              "item_template": {
                "type": "core://Tappable",
                "content_description": "Open $item.title",
                "on_click": {
                  "intent": "action.sequence",
                  "steps": [
                    {
                      "intent": "action.navigation.open",
                      "layout": "taste_item",
                      "presentation": "Sheet",
                      "params": {
                        "key": "$item.key"
                      }
                    },
                    {
                      "intent": "action.data.load",
                      "path": "/v1/taste/screens/item?key=$item.key"
                    }
                  ]
                },
                "content": {
                  "type": "core://Column",
                  "children": [
                    {
                      "type": "core://Image",
                      "url": "$item.thumb",
                      "aspect_ratio": 0.8,
                      "shape": "Rounded",
                      "content_description": "$item.title"
                    },
                    {
                      "type": "core://Text",
                      "value_expr": "$item.brand",
                      "style": "Caption",
                      "caps": true,
                      "max_lines": 1
                    },
                    {
                      "type": "core://Text",
                      "value_expr": "$item.title",
                      "style": "Secondary",
                      "max_lines": 2
                    }
                  ],
                  "spacing_dp": 4
                }
              },
              "spacing_dp": 12,
              "empty_text": "Nothing close to it.",
              "columns": 3
            }
          ]
        }
      ]
    }
  }
}
