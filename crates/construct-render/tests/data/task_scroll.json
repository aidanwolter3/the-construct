{
 "note": "A made-up task list shaped like the Construct Tasks layout (sections of rows in one scroll), for the scroll benchmark (bench.rs).",
 "layout": {
  "type": "core://Column",
  "children": [
   {
    "type": "core://Row",
    "children": [
     {
      "type": "core://Column",
      "padding_h_dp": 16,
      "padding_v_dp": 12,
      "children": [
       {
        "style": "Headline",
        "type": "core://Text",
        "value_expr": "Construct Tasks"
       }
      ]
     }
    ]
   },
   {
    "type": "core://Scroll",
    "id": "tasks_scroll",
    "content": {
     "type": "core://Column",
     "padding_h_dp": 16,
     "padding_v_dp": 8,
     "spacing_dp": 0,
     "children": [
      {
       "type": "core://Box",
       "corner_dp": 12,
       "border_color": "#E4E4E7",
       "content": {
        "type": "core://Row",
        "align": "Center",
        "padding_h_dp": 14,
        "padding_v_dp": 12,
        "spacing_dp": 8,
        "children": [
         {
          "type": "core://Box",
          "background": "#0E9F6E",
          "corner_dp": 5,
          "width_dp": 10,
          "height_dp": 10,
          "content": {
           "type": "core://Spacer"
          }
         },
         {
          "style": "Label",
          "type": "core://Text",
          "value_expr": "Agents"
         },
         {
          "type": "core://Spacer"
         },
         {
          "type": "core://Box",
          "background": "#1C64F2",
          "content_color": "#FFFFFF",
          "corner_dp": 6,
          "padding_h_dp": 8,
          "padding_v_dp": 3,
          "content": {
           "style": "Caption",
           "type": "core://Text",
           "value_expr": "3 working"
          }
         }
        ]
       }
      },
      {
       "type": "core://Column",
       "children": [
        {
         "type": "core://Spacer",
         "size_dp": 16
        },
        {
         "type": "core://Row",
         "align": "Center",
         "padding_v_dp": 6,
         "spacing_dp": 8,
         "children": [
          {
           "type": "core://Box",
           "background": "#E3A008",
           "corner_dp": 2,
           "width_dp": 4,
           "height_dp": 18,
           "content": {
            "type": "core://Spacer"
           }
          },
          {
           "type": "core://Box",
           "content_color": "#E3A008",
           "content": {
            "style": "Label",
            "type": "core://Text",
            "value_expr": "In progress"
           }
          }
         ]
        }
       ]
      },
      {
       "type": "core://List",
       "query_key": "tasks:all",
       "spacing_dp": 0,
       "where": [
        {
         "field": "status",
         "equals": "started"
        }
       ],
       "item_template": {
        "type": "core://Tappable",
        "content_description": "Open $item.title",
        "on_click": {
         "intent": "action.navigation.open",
         "presentation": "Push",
         "target_uri": "demo://tasks/$item.id"
        },
        "content": {
         "type": "core://Column",
         "children": [
          {
           "type": "core://Row",
           "align": "Center",
           "padding_h_dp": 12,
           "padding_v_dp": 8,
           "spacing_dp": 10,
           "children": [
            {
             "type": "core://Box",
             "align": "Center",
             "width_dp": 40,
             "content": {
              "type": "core://Progress",
              "size_dp": 18
             }
            },
            {
             "type": "core://Column",
             "spacing_dp": 2,
             "children": [
              {
               "style": "Body",
               "type": "core://Text",
               "value_expr": "$item.title"
              },
              {
               "style": "Caption",
               "type": "core://Text",
               "value_expr": "$item.caption"
              }
             ]
            },
            {
             "type": "core://Spacer"
            },
            {
             "type": "core://Box",
             "corner_dp": 0,
             "content_color": "#6B6B76",
             "content": {
              "style": "Display",
              "type": "core://Text",
              "value_expr": "›"
             }
            }
           ]
          },
          {
           "type": "core://Divider"
          }
         ]
        }
       }
      },
      {
       "type": "core://Column",
       "children": [
        {
         "type": "core://Spacer",
         "size_dp": 16
        },
        {
         "type": "core://Row",
         "align": "Center",
         "padding_v_dp": 6,
         "spacing_dp": 8,
         "children": [
          {
           "type": "core://Box",
           "background": "#3F83F8",
           "corner_dp": 2,
           "width_dp": 4,
           "height_dp": 18,
