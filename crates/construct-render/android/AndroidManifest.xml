<?xml version="1.0" encoding="utf-8"?>
<!-- The engine's Android app: a NativeActivity drawn by libconstruct_render.so (scripts/android_native.sh), installed as
     The Construct itself (the main app's package), so it keeps the main app's data and sign-in. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.theconstruct.android"
    android:versionCode="1"
    android:versionName="0.1">
    <!-- Target 34: the system keeps the window below the status bar and camera cutout and resizes it for the
         keyboard (35+ draws edge to edge). -->
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="34" />
    <uses-feature android:name="android.hardware.vulkan.version" android:required="false" />
    <!-- A live session (scripts/android_native.sh with pod): layouts, data and images from the pod. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Notifications from the bridge's receiver (Android 13+ asks the user). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Push (PushReceiver, the UnifiedPush connector's receiver): it holds a wake lock while a message is handled,
         and finds the installed distributors (ntfy, ...) by these actions. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <queries>
        <intent>
            <action android:name="org.unifiedpush.android.distributor.REGISTER" />
        </intent>
        <intent>
            <action android:name="org.unifiedpush.android.distributor.UNREGISTER" />
        </intent>
    </queries>
    <application
        android:label="The Construct"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:hasCode="true"
        android:debuggable="true"
        android:extractNativeLibs="true"
        android:theme="@style/Construct">
        <!-- The bridge (android/java): NativeActivity plus the callbacks it doesn't pass on (links, the photo
             picker's result), each forwarded to Rust. singleTask: a link reaches this same activity (onNewIntent). -->
        <activity
            android:name=".ConstructActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|fontWeightAdjustment|colorMode|layoutDirection|locale"
            android:windowSoftInputMode="adjustResize">
            <meta-data android:name="android.app.lib_name" android:value="construct_render" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Links into the app: construct://oauth (the sign-in redirect the main app uses) and construct://bridge
                 (the prototype's test link). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="construct" android:host="oauth" />
                <data android:scheme="construct" android:host="bridge" />
            </intent-filter>
            <!-- The sign-in redirect as a verified App Link (decision android-app-link-sign-in-redirect), for the
                 staging pod (src/signin.rs APP_LINK_HOST): used once Android has verified it against the pod's
                 assetlinks.json (this build's signing cert listed), else construct://oauth above. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="the-construct-pod.fly.dev" />
                <data android:path="/oauth/android" />
            </intent-filter>
        </activity>
        <!-- A message for the app, also while it is closed (what a push does). Only the shell (adb) and the system
             hold DUMP, so no other app can send one. -->
        <receiver
            android:name=".ConstructReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- What the UnifiedPush distributor sends (an endpoint, a push message, the end of a registration), also
             while the app is closed; forwarded to Rust (src/push.rs). The connector checks each broadcast's token,
             and messages are encrypted to this app's own keys. -->
        <receiver
            android:name=".PushReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.MESSAGE" />
                <action android:name="org.unifiedpush.android.connector.UNREGISTERED" />
                <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
                <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED" />
                <action android:name="org.unifiedpush.android.connector.REGISTRATION_REFUSED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
