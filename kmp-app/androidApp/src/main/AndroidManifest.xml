<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Notifications from apps (DECISIONS D52); asked for at runtime on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Cleartext HTTP only to the dev server (10.0.2.2 / localhost / 127.0.0.1), in all builds since the menu's
         server picker ships in release too: res/xml/network_security_config.xml (DECISIONS D11, D29). -->
    <!-- No backups or device-to-device transfers (security audit #31, L10): cache.db and the `push` preferences
         (Web Push endpoints and keys) are not encrypted. allowBackup covers Android 11 and older,
         res/xml/data_extraction_rules.xml Android 12+ (where allowBackup no longer stops device transfers). -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="The Construct"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- singleTask: the OAuth redirect (opened by the browser in its own task) must reach this same activity
             instance and engine via onNewIntent (DECISIONS D19).
             adjustResize: the window is not panned for the keyboard; Compose gets the IME insets instead and the
             root's safeDrawingPadding lifts the menu's custom server URL field above the keyboard. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="construct" android:host="oauth" />
            </intent-filter>
            <!-- The sign-in redirect as a verified App Link (decision android-app-link-sign-in-redirect, security audit
                 #31): Android checks https://<host>/.well-known/assetlinks.json for this build's signing cert and then
                 opens these links only in this app. Used for the pod on that host once verified; construct://oauth
                 above stays for other servers, older pods and the pod's fallback page. Host: -PconstructAppLinkHost. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="${constructAppLinkHost}" />
                <data android:path="/oauth/android" />
            </intent-filter>
        </activity>
        <!-- Notification taps (D52) come through this non-exported activity, which forwards them to MainActivity with
             a per-process nonce: MainActivity is exported, so it ignores notification extras without one (#31, L11).
             Own empty task affinity and no history: it finishes at once and never shows in recents. -->
        <activity
            android:name=".NotificationTapActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />
        <!-- Web Push messages from the pod, delivered by a UnifiedPush distributor (or the embedded FCM one), also
             while the app is closed (DECISIONS D52). -->
        <service
            android:name=".PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
